## LanternsSources is the Lanterns modules' code, its comments taken out, for
## the page's code pane. It is generated: tools/bundle_lanterns_sources.shale
## writes it from the modules, and the gate fails when it is stale. Do not
## edit it.
LanternsSources :: [].{

	## Each module's file name, and its code without its comments.
	modules : List({ file : Str, code : Str })
	modules = [
		{ file: "BackdropShapes.roc", code: "import RoadCamera\nimport Sunrise\nimport lib.Brush\nimport lib.Fraction\nimport lib.Pixels\nimport lib.Point\nimport lib.RgbColor\nimport lib.Shapes\nimport lib.WidthShading\n\nBackdropShapes :: [].{\n\n\tbackdrop_shapes : RoadCamera, Sunrise.Light -> List(Shapes.Shape)\n\tbackdrop_shapes = |camera, light| {\n\t\tsky = Shapes.rectangle({\n\t\t\ttop_left: Point.at(0.0, 0.0),\n\t\t\twidth: Pixels.of(RoadCamera.screen_width),\n\t\t\theight: Pixels.of(RoadCamera.horizon_y + 1.0),\n\t\t\tfill: Brush.linear_gradient({\n\t\t\t\tstops: {\n\t\t\t\t\tstart_color: Brush.opaque_rgba(light.sky_top),\n\t\t\t\t\tend_color: Brush.opaque_rgba(light.sky_horizon),\n\t\t\t\t\tstart_offset: 0.2,\n\t\t\t\t\tend_offset: 1.0,\n\t\t\t\t},\n\t\t\t\tstart_point: Point.at(0.0, 0.0),\n\t\t\t\tend_point: Point.at(0.0, RoadCamera.horizon_y),\n\t\t\t}),\n\t\t})\n\t\tsun_center = light.sun_center\n\t\tsun_glow = Shapes.halo({ center: sun_center, radius: Pixels.of(300.0) }, Brush.with_alpha(light.sun_glow, light.sun_glow_alpha))\n\t\tsun = Disc({\n\t\t\tcenter: sun_center,\n\t\t\tradius: Sunrise.sun_radius,\n\t\t\tfill: Radial({\n\t\t\t\tinner_color: Brush.opaque_rgba(light.sun_inner),\n\t\t\t\touter_color: Brush.opaque_rgba(light.sun_outer),\n\t\t\t\tcenter: sun_center,\n\t\t\t\tinner_radius: Pixels.zero,\n\t\t\t\touter_radius: Sunrise.sun_radius,\n\t\t\t}),\n\t\t})\n\t\tfar = Polygon({ corners: Sunrise.far_range_corners, fill: WidthShading.corners_shade(Sunrise.far_range_corners, { color: light.far_range, strength: Fraction.of(0.6) }) })\n\t\tnear_fill = WidthShading.corners_shade(near_hills, { color: light.hills, strength: Fraction.of(0.8) })\n\t\thills = Polygon({ corners: near_hills, fill: near_fill })\n\t\tgrass = Shapes.rectangle({\n\t\t\ttop_left: Point.at(0.0, RoadCamera.horizon_y),\n\t\t\twidth: Pixels.of(RoadCamera.screen_width),\n\t\t\theight: Pixels.of(RoadCamera.screen_height - RoadCamera.horizon_y),\n\t\t\tfill: Brush.linear_gradient({\n\t\t\t\tstops: {\n\t\t\t\t\tstart_color: Brush.opaque_rgba(light.grass_far),\n\t\t\t\t\tend_color: Brush.opaque_rgba(light.grass_near),\n\t\t\t\t\tstart_offset: 0.0,\n\t\t\t\t\tend_offset: 1.0,\n\t\t\t\t},\n\t\t\t\tstart_point: Point.at(0.0, RoadCamera.horizon_y),\n\t\t\t\tend_point: Point.at(0.0, RoadCamera.screen_height),\n\t\t\t}),\n\t\t})\n\t\tnear = camera.along() + 1.5\n\t\tfar_along = camera.along() + 5000.0\n\t\troad = ground_quad_shapes(camera, { near, far: far_along, left: 0.0 - road_half_width, right: road_half_width }, light.road)\n\t\t[sky, sun_glow, sun, far, hills, grass].concat(road).concat(dash_shapes(camera))\n\t}\n}\n\nline_color : RgbColor\nline_color = RgbColor.of(0xE8DDB8)\n\nroad_half_width : F64\nroad_half_width = 2.0\n\nnear_hills : List(Point)\nnear_hills = [\n\tPoint.at(0.0, 330.0),\n\tPoint.at(150.0, 300.0),\n\tPoint.at(300.0, 346.0),\n\tPoint.at(470.0, 312.0),\n\tPoint.at(640.0, 352.0),\n\tPoint.at(800.0, 306.0),\n\tPoint.at(960.0, 336.0),\n\tPoint.at(960.0, RoadCamera.horizon_y + 1.0),\n\tPoint.at(0.0, RoadCamera.horizon_y + 1.0),\n]\n\ndash_spacing : F64\ndash_spacing = 9.0\n\ndash_length : F64\ndash_length = 3.0\n\ndash_reach : F64\ndash_reach = 240.0\n\ndash_shapes : RoadCamera -> List(Shapes.Shape)\ndash_shapes = |camera| {\n\tfirst_dash = (camera.along() / dash_spacing).floor_to_i64_try() ?? crash \"BackdropShapes.dash_shapes: a road longer than an I64 of dashes\"\n\tcount = (dash_reach / dash_spacing).floor_to_u64_try() ?? crash \"BackdropShapes.dash_shapes: a reach that is no count of dashes\"\n\tvar \$shapes = []\n\tfor k in 0..<count {\n\t\tstart = (first_dash + k.to_i64_wrap()).to_f64() * dash_spacing\n\t\tnear = start.max(camera.along() + 1.5)\n\t\tfar = start + dash_length\n\t\tif far > near {\n\t\t\t\$shapes = \$shapes.concat(ground_quad_shapes(camera, { near, far, left: -0.08, right: 0.08 }, line_color))\n\t\t} else {\n\t\t\t{}\n\t\t}\n\t}\n\t\$shapes\n}\n\nground_quad_shapes : RoadCamera,\n{\n\tnear : F64,\n\tfar : F64,\n\tleft : F64,\n\tright : F64,\n},\nRgbColor -> List(Shapes.Shape)\nground_quad_shapes = |camera, { near, far, left, right }, color| {\n\tcorner = |along, across| camera.project({ along, across, lift: 0.0 })\n\tcorners = [corner(near, left), corner(far, left), corner(far, right), corner(near, right)]\n\tmatch corners {\n\t\t[Ok(first), Ok(second), Ok(third), Ok(fourth)] => [Quad({ first, second, third, fourth, fill: Brush.flat(color) })]\n\t\t_ => []\n\t}\n}\n" },
		{ file: "BannerPlane.roc", code: "import RoadCamera\nimport lib.Brush\nimport lib.Font\nimport lib.Pixels\nimport lib.Point\nimport lib.RgbColor\nimport lib.Shapes\n\nBannerPlane :: [].{\n\n\tFlight : [Coming, InView(Point), Gone]\n\n\tflight_at : U64 -> BannerPlane.Flight\n\tflight_at = |steps|\n\t\tif steps < enters_step {\n\t\t\tComing\n\t\t} else {\n\t\t\tnose_x = (steps - enters_step + 1).to_f64() * speed\n\t\t\tif nose_x - tail_reach >= RoadCamera.screen_width {\n\t\t\t\tGone\n\t\t\t} else {\n\t\t\t\tbob = bob_height * (F64.tau * steps.to_f64() / bob_steps).sin()\n\t\t\t\tInView(Point.at(nose_x, cruise_y + bob))\n\t\t\t}\n\t\t}\n\n\tshapes_at : U64 -> List(Shapes.Shape)\n\tshapes_at = |steps|\n\t\tmatch flight_at(steps) {\n\t\t\tInView(nose) => banner_shapes({ nose, steps }).concat(tow_line_shapes(nose)).concat(plane_shapes(nose))\n\t\t\tComing => []\n\t\t\tGone => []\n\t\t}\n}\n\nenters_step : U64\nenters_step = 400\n\nspeed : F64\nspeed = 1.75\n\ncruise_y : F64\ncruise_y = 54.0\n\nbob_height : F64\nbob_height = 1.5\n\nbob_steps : F64\nbob_steps = 96.0\n\nbanner_front : F64\nbanner_front = 95.0\n\nbanner_length : F64\nbanner_length = 300.0\n\ntail_reach : F64\ntail_reach = banner_front + banner_length\n\nbanner_half_height : F64\nbanner_half_height = 15.0\n\nbanner_words : Str\nbanner_words = \"Welcome to Roc!\"\n\nletter_size : F64\nletter_size = 18.0\n\nletter_inset : F64\nletter_inset = 18.0\n\nripple_height : F64\nripple_height = 2.5\n\nripple_length : F64\nripple_length = 120.0\n\nripple_speed : F64\nripple_speed = 0.2\n\nbody_color : RgbColor\nbody_color = RgbColor.of(0xD2402F)\n\nwing_color : RgbColor\nwing_color = RgbColor.of(0x9E2C22)\n\nwindow_color : RgbColor\nwindow_color = RgbColor.of(0xA8D4F0)\n\ndark_color : RgbColor\ndark_color = RgbColor.of(0x34343C)\n\nbanner_color : RgbColor\nbanner_color = RgbColor.of(0xFBF4DC)\n\nhem_color : RgbColor\nhem_color = RgbColor.of(0xD8C9A0)\n\nletter_color : RgbColor\nletter_color = RgbColor.of(0x5B2FB0)\n\noff_nose : Point, { dx : F64, dy : F64 } -> Point\noff_nose = |nose, { dx, dy }| Point.at(nose.x.to_f64() + dx, nose.y.to_f64() + dy)\n\nplane_part : Point, List((F64, F64)), Brush.Fill -> Shapes.Shape\nplane_part = |nose, offsets, fill| Shapes.region_from_corners(offsets.map(|(dx, dy)| off_nose(nose, { dx, dy })), fill)\n\nplane_line : Point, { from : (F64, F64), to : (F64, F64) } -> Shapes.Shape\nplane_line = |nose, { from: (x0, y0), to: (x1, y1) }|\n\tShapes.line(\n\t\t{ from: off_nose(nose, { dx: x0, dy: y0 }), to: off_nose(nose, { dx: x1, dy: y1 }), width: Pixels.of(1.2) },\n\t\tBrush.flat(dark_color),\n\t)\n\nplane_shapes : Point -> List(Shapes.Shape)\nplane_shapes = |nose| {\n\tvar \$wheel_corners = List.with_capacity(8)\n\tfor k in 0..<8 {\n\t\tangle = F64.tau * k.to_f64() / 8.0\n\t\t\$wheel_corners = \$wheel_corners.append((-15.0 + 2.4 * angle.cos(), 9.0 + 2.4 * angle.sin()))\n\t}\n\twheel_corners = \$wheel_corners\n\t[\n\t\tplane_part(nose, [(-40.0, -5.0), (-50.0, -15.0), (-55.0, -15.0), (-54.0, -3.0)], Brush.flat(wing_color)),\n\t\tplane_part(\n\t\t\tnose,\n\t\t\t[(0.0, -2.0), (-3.0, -5.0), (-9.0, -6.0), (-36.0, -5.0), (-52.0, -3.0), (-55.0, -1.0), (-52.0, 1.0), (-36.0, 3.0), (-8.0, 5.0), (-2.0, 4.0), (0.0, 2.0)],\n\t\t\tBrush.flat(body_color),\n\t\t),\n\t\tplane_part(nose, [(-44.0, -1.0), (-57.0, -2.0), (-57.0, 1.0), (-44.0, 1.0)], Brush.flat(wing_color)),\n\t\tplane_part(nose, [(-9.0, -5.0), (-19.0, -5.0), (-19.0, -1.0), (-7.0, -1.0)], Brush.flat(window_color)),\n\t\tplane_line(nose, { from: (-24.0, -6.0), to: (-17.0, 3.0) }),\n\t\tplane_part(nose, [(-9.0, -8.0), (-30.0, -8.0), (-31.0, -6.0), (-8.0, -6.0)], Brush.flat(wing_color)),\n\t\tplane_line(nose, { from: (-13.0, 4.0), to: (-15.0, 8.0) }),\n\t\tplane_part(nose, wheel_corners, Brush.flat(dark_color)),\n\t\tplane_part(nose, [(0.0, -2.0), (3.0, 0.0), (0.0, 2.0)], Brush.flat(dark_color)),\n\t\tplane_part(nose, [(1.0, -8.0), (2.5, -8.0), (2.5, 8.0), (1.0, 8.0)], Flat(Brush.with_alpha(RgbColor.of(0xE0E0E8), 0.55))),\n\t]\n}\n\ntow_line_shapes : Point -> List(Shapes.Shape)\ntow_line_shapes = |nose| {\n\tbridle = (-(banner_front - 8.0), 0.0)\n\t[\n\t\tplane_line(nose, { from: (-57.0, 0.0), to: bridle }),\n\t\tplane_line(nose, { from: bridle, to: (-banner_front, -banner_half_height) }),\n\t\tplane_line(nose, { from: bridle, to: (-banner_front, banner_half_height) }),\n\t]\n}\n\nripple_at : { behind : F64, steps : U64 } -> F64\nripple_at = |{ behind, steps }|\n\tripple_height * behind / banner_length * (F64.tau * behind / ripple_length - steps.to_f64() * ripple_speed).sin()\n\nrippled_point : Point, { nose : Point, steps : U64 } -> Point\nrippled_point = |point, { nose, steps }| {\n\tbehind = nose.x.to_f64() - banner_front - point.x.to_f64()\n\tPoint.at(point.x.to_f64(), point.y.to_f64() + ripple_at({ behind, steps }))\n}\n\nstrip_shape : { nose : Point, steps : U64 }, { half_height : F64, color : RgbColor } -> Shapes.Shape\nstrip_shape = |flying, { half_height, color }| {\n\tsamples = 29\n\tfront = -banner_front\n\tvar \$corners = List.with_capacity(2 * (samples + 1))\n\tfor k in 0..=samples {\n\t\tdx = front - banner_length * k.to_f64() / samples.to_f64()\n\t\t\$corners = \$corners.append(rippled_point(off_nose(flying.nose, { dx, dy: -half_height }), flying))\n\t}\n\tfor k in 0..=samples {\n\t\tdx = front - banner_length * (samples - k).to_f64() / samples.to_f64()\n\t\t\$corners = \$corners.append(rippled_point(off_nose(flying.nose, { dx, dy: half_height }), flying))\n\t}\n\tShapes.region_from_corners(\$corners, Brush.flat(color))\n}\n\nrippled_stroke : Shapes.Shape, { nose : Point, steps : U64 } -> Shapes.Shape\nrippled_stroke = |shape, flying|\n\tmatch shape {\n\t\tQuad(q) =>\n\t\t\tQuad({\n\t\t\t\t..q,\n\t\t\t\tfirst: rippled_point(q.first, flying),\n\t\t\t\tsecond: rippled_point(q.second, flying),\n\t\t\t\tthird: rippled_point(q.third, flying),\n\t\t\t\tfourth: rippled_point(q.fourth, flying),\n\t\t\t})\n\t\t_ => crash \"BannerPlane.rippled_stroke: Font draws a stroke as a quad\"\n\t}\n\nbanner_shapes : { nose : Point, steps : U64 } -> List(Shapes.Shape)\nbanner_shapes = |flying| {\n\them = strip_shape(flying, { half_height: banner_half_height + 1.0, color: hem_color })\n\tstrip = strip_shape(flying, { half_height: banner_half_height, color: banner_color })\n\tbar = plane_part(\n\t\tflying.nose,\n\t\t[(-banner_front, -banner_half_height - 1.0), (-banner_front + 2.0, -banner_half_height - 1.0), (-banner_front + 2.0, banner_half_height + 1.0), (-banner_front, banner_half_height + 1.0)],\n\t\tBrush.flat(dark_color),\n\t)\n\twords_top_left = off_nose(flying.nose, { dx: -tail_reach + letter_inset, dy: -letter_size / 2.0 })\n\twords = Font.text_shapes(banner_words, { top_left: words_top_left, size: letter_size, color: Brush.opaque_rgba(letter_color) })\n\t[hem, strip, bar].concat(words.map(|stroke| rippled_stroke(stroke, flying)))\n}\n\nexpect BannerPlane.flight_at(enters_step - 1) == Coming and BannerPlane.shapes_at(enters_step - 1) == []\nexpect\n\tmatch BannerPlane.flight_at(enters_step) {\n\t\tInView(nose) => nose.x.to_f64() == speed and !BannerPlane.shapes_at(enters_step).is_empty()\n\t\t_ => Bool.False\n\t}\n\nexpect enters_step == 400\nexpect\n\tmatch BannerPlane.flight_at(1173) {\n\t\tInView(nose) => nose.x.to_f64() - tail_reach < RoadCamera.screen_width\n\t\t_ => Bool.False\n\t}\nexpect BannerPlane.flight_at(1174) == Gone and BannerPlane.shapes_at(1174) == []\nexpect BannerPlane.flight_at(1349) == Gone\n\nexpect letter_inset + Font.width_of(banner_words, letter_size) - letter_size / 3.0 + letter_inset <= banner_length\n\nexpect ripple_at({ behind: 0.0, steps: 17 }) == 0.0\nexpect {\n\tvar \$highest = 0.0\n\tfor steps in 0..<60 {\n\t\t\$highest = \$highest.max(ripple_at({ behind: banner_length, steps }).abs())\n\t}\n\t\$highest <= ripple_height and \$highest > ripple_height * 0.9\n}\n" },
		{ file: "Bird.roc", code: "import BirdFlight\nimport BirdStills\nimport Still\nimport StillOnScreen\n\nBird :: [].{\n\n\theight_metres : F64\n\theight_metres = 4.2\n\n\tpose_still : BirdFlight.BirdPose -> Still\n\tpose_still = |pose|\n\t\tmatch pose {\n\t\t\tPerched => BirdStills.perched_still\n\t\t\tSide(WingsUp) => BirdStills.side_wings_up_still\n\t\t\tSide(WingsDown) => BirdStills.side_wings_down_still\n\t\t\tAway(WingsUp) => BirdStills.away_wings_up_still\n\t\t\tAway(WingsDown) => BirdStills.away_wings_down_still\n\t\t\tDiving => BirdStills.diving_still\n\t\t}\n\n\tpose_flip : BirdFlight.BirdPose, BirdFlight.Heading -> StillOnScreen.Flip\n\tpose_flip = |pose, heading|\n\t\tmatch (pose, heading) {\n\t\t\t(Away(_), _) => AsDrawn\n\t\t\t(_, Rightward) => AsDrawn\n\t\t\t(_, Leftward) => Mirrored\n\t\t}\n}\n\nexpect [Perched, Side(WingsUp), Diving].all(|pose| Bird.pose_flip(pose, Leftward) == Mirrored)\nexpect [Perched, Side(WingsDown), Diving].all(|pose| Bird.pose_flip(pose, Rightward) == AsDrawn)\nexpect [Away(WingsUp), Away(WingsDown)].all(|pose| Bird.pose_flip(pose, Leftward) == AsDrawn)\n" },
		{ file: "BirdFlight.roc", code: "import Easing\nimport RoadLamps\nimport lib.Fraction\n\nBirdFlight := { from : RoadLamps.RoadLamp, to : RoadLamps.RoadLamp }.{\n\n\tWingBeat : [WingsUp, WingsDown]\n\n\tBirdPose : [\n\t\tPerched,\n\t\tSide(BirdFlight.WingBeat),\n\t\tAway(BirdFlight.WingBeat),\n\t\tDiving,\n\t]\n\n\tHeading : [Rightward, Leftward]\n\n\tLocation : { along : F64, across : F64, lift : F64 }\n\n\tBirdInstant : { pose : BirdFlight.BirdPose, location : BirdFlight.Location }\n\n\tStage : [Waiting, Playing(U64)]\n\n\tfirst : BirdFlight\n\tfirst = BirdFlight.flight_from(RoadLamps.lamp_at(Left, 0))\n\n\tflight_from : RoadLamps.RoadLamp -> BirdFlight\n\tflight_from = |perch| BirdFlight.({ from: perch, to: RoadLamps.lamp_at(RoadLamps.other_side(perch.side), perch.place + 1) })\n\n\tlamps : BirdFlight -> { from : RoadLamps.RoadLamp, to : RoadLamps.RoadLamp }\n\tlamps = |BirdFlight.(ends)| ends\n\n\tis_eq : _\n\n\tnext : BirdFlight -> BirdFlight\n\tnext = |flight| BirdFlight.flight_from(flight.to)\n\n\theading : BirdFlight -> BirdFlight.Heading\n\theading = |flight|\n\t\tif flight.to.across > flight.from.across {\n\t\t\tRightward\n\t\t} else {\n\t\t\tLeftward\n\t\t}\n\n\tframe_count : U64\n\tframe_count = flight_frames.len()\n\n\tbird_instant_at : BirdFlight, BirdFlight.Stage -> BirdFlight.BirdInstant\n\tbird_instant_at = |flight, stage|\n\t\tmatch stage {\n\t\t\tWaiting => sitting_on(flight.from)\n\t\t\tPlaying(steps_in) =>\n\t\t\t\tmatch flight_frames.get(steps_in) {\n\t\t\t\t\tOk({ pose, through }) => {\n\t\t\t\t\t\tpose,\n\t\t\t\t\t\tlocation: flight_location({ from: lamp_top(flight.from), to: lamp_top(flight.to), through }),\n\t\t\t\t\t}\n\t\t\t\t\tErr(OutOfBounds) => crash \"BirdFlight.bird_instant_at: a stage plays past the flight's last frame\"\n\t\t\t\t}\n\t\t}\n}\n\nflight_arc : F64\nflight_arc = 5.0\n\nframes_a_half_flap : U64\nframes_a_half_flap = 2\n\nsitting_on : RoadLamps.RoadLamp -> BirdFlight.BirdInstant\nsitting_on = |lamp| { pose: Perched, location: lamp_top(lamp) }\n\nlamp_top : RoadLamps.RoadLamp -> BirdFlight.Location\nlamp_top = |lamp| { along: lamp.along, across: lamp.across, lift: lamp.lantern.height_metres() }\n\nflight_poses : List(BirdFlight.BirdPose)\nflight_poses = [\n\tflap_poses({ up: Side(WingsUp), down: Side(WingsDown) }),\n\tList.repeat(flap_poses({ up: Away(WingsUp), down: Away(WingsDown) }), 7).join(),\n\tList.repeat(Diving, 2 * frames_a_half_flap),\n].join()\n\nFlightFrame : { pose : BirdFlight.BirdPose, through : Fraction }\n\nflight_frames : List(FlightFrame)\nflight_frames = {\n\tlast_frame = (flight_poses.len() - 1).to_f64()\n\tflight_poses.map_with_index(\n\t\t|pose, frame| { pose, through: Fraction.of(frame.to_f64() / last_frame) },\n\t)\n}\n\nflap_poses : { up : BirdFlight.BirdPose, down : BirdFlight.BirdPose } -> List(BirdFlight.BirdPose)\nflap_poses = |{ up, down }| {\n\thalf_up = List.repeat(up, frames_a_half_flap)\n\thalf_up.concat(List.repeat(down, frames_a_half_flap))\n}\n\nflight_location : {\n\tfrom : BirdFlight.Location,\n\tto : BirdFlight.Location,\n\tthrough : Fraction,\n} -> BirdFlight.Location\nflight_location = |{ from, to, through }| {\n\teased = Easing.smoothstep(through)\n\tbetween = |start, end| Easing.lerp({ from: start, to: end, fraction: eased })\n\tshare = through.to_f64()\n\tabove_line = flight_arc * 4.0 * share * (1.0 - share)\n\t{\n\t\talong: between(from.along, to.along),\n\t\tacross: between(from.across, to.across),\n\t\tlift: between(from.lift, to.lift) + above_line,\n\t}\n}\n\nexpect BirdFlight.frame_count == 36\nexpect flight_poses.first() == Ok(Side(WingsUp))\nexpect flight_poses.last() == Ok(Diving)\n\nexpect {\n\tsecond = BirdFlight.first.next()\n\tthird = second.next()\n\tBirdFlight.first.heading() == Rightward\n\t\tand second.heading() == Leftward\n\t\tand third.heading() == Rightward\n\t\tand [BirdFlight.first, second, third].all(\n\t\t\t|flight|\n\t\t\t\tflight.to.place == flight.from.place + 1\n\t\t\t\t\tand flight.to.along >= flight.from.along + RoadLamps.lamp_spacing - 2.0 * RoadLamps.most_nudge,\n\t\t)\n}\n\nexpect {\n\tflight = BirdFlight.first\n\tat_start = flight.bird_instant_at(Playing(0)).location\n\tat_end = flight.bird_instant_at(Playing(BirdFlight.frame_count - 1)).location\n\tat_start == lamp_top(flight.from) and at_end == lamp_top(flight.to)\n}\nexpect {\n\tfrom = { along: 0.0, across: -3.5, lift: 6.0 }\n\tto = { along: 30.0, across: 3.5, lift: 6.0 }\n\tflight_location({ from, to, through: Fraction.of(0.5) }) == { along: 15.0, across: 0.0, lift: 11.0 }\n}\n" },
		{ file: "BirdStills.roc", code: "import Still\nimport lib.RgbColor\n\nBirdStills :: [].{\n\n\tperched_still : Still\n\tperched_still = Still.of([\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.0344, y: 0.5715 }, { x: -0.148, y: 0.0 }, { x: 0.0368, y: 0.1469 }, { x: 0.0183, y: 0.2577 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.2216, y: 0.6413 }, { x: 0.3497, y: 0.5025 }, { x: 0.3679, y: 0.5849 }, { x: 0.3862, y: 0.6862 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.0305, y: 0.9394 }, { x: -0.4811, y: 1.0 }, { x: -0.0344, y: 0.5715 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.3497, y: 0.5025 }, { x: -0.0344, y: 0.5715 }, { x: 0.0183, y: 0.2577 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: 0.4717, y: 0.5849 }, { x: 0.3862, y: 0.6862 }, { x: 0.3679, y: 0.5849 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.0344, y: 0.5715 }, { x: 0.3497, y: 0.5025 }, { x: 0.2216, y: 0.6413 }, { x: -0.0305, y: 0.9394 }] },\n\t])\n\n\tside_wings_up_still : Still\n\tside_wings_up_still = Still.of([\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.45, y: 0.42 }, { x: -0.8, y: 0.5 }, { x: -0.74, y: 0.32 }, { x: -0.1, y: 0.3 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.45, y: 0.42 }, { x: 0.3, y: 0.52 }, { x: 0.36, y: 0.4 }, { x: -0.1, y: 0.3 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: 0.3, y: 0.52 }, { x: 0.52, y: 0.5 }, { x: 0.36, y: 0.4 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.52, y: 0.5 }, { x: 0.66, y: 0.43 }, { x: 0.44, y: 0.44 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.12, y: 0.46 }, { x: 0.18, y: 0.5 }, { x: -0.18, y: 0.98 }, { x: -0.42, y: 0.9 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.18, y: 0.98 }, { x: -0.42, y: 0.9 }, { x: -0.64, y: 1.0 }] },\n\t])\n\n\tside_wings_down_still : Still\n\tside_wings_down_still = Still.of([\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.45, y: 0.52 }, { x: -0.8, y: 0.6 }, { x: -0.74, y: 0.42 }, { x: -0.1, y: 0.4 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.45, y: 0.52 }, { x: 0.3, y: 0.62 }, { x: 0.36, y: 0.5 }, { x: -0.1, y: 0.4 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: 0.3, y: 0.62 }, { x: 0.52, y: 0.6 }, { x: 0.36, y: 0.5 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.52, y: 0.6 }, { x: 0.66, y: 0.53 }, { x: 0.44, y: 0.54 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.12, y: 0.52 }, { x: 0.18, y: 0.54 }, { x: -0.02, y: 0.08 }, { x: -0.3, y: 0.14 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.02, y: 0.08 }, { x: -0.3, y: 0.14 }, { x: -0.3, y: 0.0 }] },\n\t])\n\n\taway_wings_up_still : Still\n\taway_wings_up_still = Still.of([\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.06, y: 0.58 }, { x: -0.96, y: 0.86 }, { x: -0.92, y: 0.66 }, { x: -0.06, y: 0.42 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.06, y: 0.58 }, { x: 0.96, y: 0.86 }, { x: 0.92, y: 0.66 }, { x: 0.06, y: 0.42 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.1, y: 0.62 }, { x: 0.1, y: 0.62 }, { x: 0.08, y: 0.3 }, { x: -0.08, y: 0.3 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.08, y: 0.32 }, { x: 0.08, y: 0.32 }, { x: 0.22, y: 0.08 }, { x: 0.0, y: 0.0 }, { x: -0.22, y: 0.08 }] },\n\t])\n\n\taway_wings_down_still : Still\n\taway_wings_down_still = Still.of([\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.06, y: 0.56 }, { x: -0.94, y: 0.36 }, { x: -0.86, y: 0.2 }, { x: -0.06, y: 0.4 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.06, y: 0.56 }, { x: 0.94, y: 0.36 }, { x: 0.86, y: 0.2 }, { x: 0.06, y: 0.4 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.1, y: 0.62 }, { x: 0.1, y: 0.62 }, { x: 0.08, y: 0.3 }, { x: -0.08, y: 0.3 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.08, y: 0.32 }, { x: 0.08, y: 0.32 }, { x: 0.22, y: 0.08 }, { x: 0.0, y: 0.0 }, { x: -0.22, y: 0.08 }] },\n\t])\n\n\tdiving_still : Still\n\tdiving_still = Still.of([\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.2, y: 0.9 }, { x: 0.0, y: 0.96 }, { x: -0.16, y: 1.0 }, { x: -0.3, y: 1.0 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: -0.04, y: 0.68 }, { x: 0.08, y: 0.5 }, { x: -0.5, y: 0.94 }, { x: -0.62, y: 0.8 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: -0.2, y: 0.9 }, { x: 0.0, y: 0.96 }, { x: 0.22, y: 0.3 }, { x: 0.08, y: 0.24 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.02, y: 0.76 }, { x: 0.12, y: 0.58 }, { x: 0.46, y: 1.0 }, { x: 0.3, y: 1.0 }] },\n\t\t{ fill: Flat(logo_dark), points: [{ x: 0.08, y: 0.24 }, { x: 0.22, y: 0.3 }, { x: 0.2, y: 0.1 }] },\n\t\t{ fill: Flat(logo_light), points: [{ x: 0.12, y: 0.16 }, { x: 0.24, y: 0.18 }, { x: 0.25, y: 0.0 }] },\n\t])\n}\n\nlogo_dark : RgbColor\nlogo_dark = RgbColor.of(0x612BDE)\n\nlogo_light : RgbColor\nlogo_light = RgbColor.of(0x8257E5)\n\nall_stills : List(Still)\nall_stills = [\n\tBirdStills.perched_still,\n\tBirdStills.side_wings_up_still,\n\tBirdStills.side_wings_down_still,\n\tBirdStills.away_wings_up_still,\n\tBirdStills.away_wings_down_still,\n\tBirdStills.diving_still,\n]\n\nis_within_bounds : Still -> Bool\nis_within_bounds = |still|\n\tstill.polygons().all(\n\t\t|poly| poly.points.all(|pt| pt.x >= -1.0 and pt.x <= 1.0 and pt.y >= 0.0 and pt.y <= 1.0),\n\t)\n\nis_logo_coloured : Still -> Bool\nis_logo_coloured = |still| still.polygons().all(|poly| poly.fill == Flat(logo_dark) or poly.fill == Flat(logo_light))\n\nexpect all_stills.all(is_within_bounds)\nexpect\n\t!is_within_bounds(\n\t\tStill.of([\n\t\t\t{\n\t\t\t\tfill: Flat(logo_dark),\n\t\t\t\tpoints: [{ x: 0.5, y: 0.5 }, { x: 1.1, y: 0.5 }, { x: 0.5, y: 0.9 }],\n\t\t\t},\n\t\t]),\n\t)\n\nexpect all_stills.all(is_logo_coloured)\nexpect\n\t!is_logo_coloured(\n\t\tStill.of([\n\t\t\t{\n\t\t\t\tfill: Flat(RgbColor.of(0)),\n\t\t\t\tpoints: [{ x: 0.0, y: 0.0 }, { x: 0.5, y: 0.0 }, { x: 0.0, y: 0.5 }],\n\t\t\t},\n\t\t]),\n\t)\n" },
		{ file: "CodeCues.roc", code: "import BannerPlane\nimport BirdFlight\nimport JetFlyBy\nimport LanternsSources\nimport SceneCycle\n\nCodeCues :: [].{\n\n\tCue : { step : U64, file : Str, page : CodeCues.Page }\n\n\tPage : [Dark, Light]\n\n\tcues : List(CodeCues.Cue)\n\tcues = [\n\t\t{ step: 0, file: \"main.roc\", page: Dark },\n\t\t{ step: 50, file: \"LanternsApp.roc\", page: Dark },\n\t\t{ step: 96, file: \"BirdFlight.roc\", page: Dark },\n\t\t{ step: 199, file: \"Sunrise.roc\", page: Dark },\n\t\t{ step: 294, file: \"RoadLamps.roc\", page: Dark },\n\t\t{ step: 400, file: \"BannerPlane.roc\", page: Dark },\n\t\t{ step: 624, file: \"RoadCamera.roc\", page: Dark },\n\t\t{ step: 765, file: \"BackdropShapes.roc\", page: Dark },\n\t\t{ step: 888, file: \"LampShapes.roc\", page: Light },\n\t\t{ step: 1020, file: \"Bird.roc\", page: Light },\n\t\t{ step: 1174, file: \"SceneCycle.roc\", page: Light },\n\t\t{ step: 1276, file: \"JetFlyBy.roc\", page: Light },\n\t]\n\n\tfile_at : U64 -> Str\n\tfile_at = |steps| CodeCues.showing_at(steps).file\n\n\tshowing_at : U64 -> { file : Str, page : CodeCues.Page, from : U64, until : U64 }\n\tshowing_at = |steps| {\n\t\tcue =\n\t\t\tmatch CodeCues.cues.find_last(|each| each.step <= steps) {\n\t\t\t\tOk(found) => found\n\t\t\t\tErr(NotFound) => crash \"CodeCues.showing_at: no cue at step 0, so step \${steps.to_str()} has no module\"\n\t\t\t}\n\t\tuntil =\n\t\t\tmatch CodeCues.cues.find_first(|each| each.step > steps) {\n\t\t\t\tOk(next) => next.step\n\t\t\t\tErr(NotFound) => SceneCycle.cycle_steps\n\t\t\t}\n\t\t{ file: cue.file, page: cue.page, from: cue.step, until }\n\t}\n\n\tcode_of : Str -> Str\n\tcode_of = |file|\n\t\tmatch LanternsSources.modules.find_first(|bundled| bundled.file == file) {\n\t\t\tOk(bundled) => bundled.code\n\t\t\tErr(NotFound) => crash \"CodeCues.code_of: \${file} is not in LanternsSources; run tools/bundle_lanterns_sources.shale\"\n\t\t}\n}\n\ntakeoff_step : U64 -> U64\ntakeoff_step = |crossing| (crossing - 1) * SceneCycle.leg_steps + SceneCycle.leg_steps - BirdFlight.frame_count\n\nexpect {\n\tvar \$before = 0\n\tvar \$out_of_order = 0\n\tfor cue in CodeCues.cues.drop_first(1) {\n\t\t\$out_of_order =\n\t\t\tif cue.step > \$before {\n\t\t\t\t\$out_of_order\n\t\t\t} else {\n\t\t\t\t\$out_of_order + 1\n\t\t\t}\n\t\t\$before = cue.step\n\t}\n\tCodeCues.cues.first().map_ok(|cue| cue.step) == Ok(0) and \$out_of_order == 0 and \$before < SceneCycle.cycle_steps\n}\n\nexpect CodeCues.cues.all(|cue| LanternsSources.modules.any(|bundled| bundled.file == cue.file))\nexpect CodeCues.cues.all(|cue| CodeCues.cues.keep_if(|other| other.file == cue.file).len() == 1)\n\nexpect [(96, 2), (294, 5), (624, 10), (888, 14), (1020, 16)].all(|(step, crossing)| takeoff_step(crossing) == step and SceneCycle.flight_stage(step % SceneCycle.leg_steps) == Playing(0))\nexpect CodeCues.file_at(199) == \"Sunrise.roc\" and CodeCues.file_at(765) == \"BackdropShapes.roc\"\nexpect BannerPlane.flight_at(399) == Coming and BannerPlane.flight_at(400) != Coming and CodeCues.file_at(400) == \"BannerPlane.roc\"\nexpect BannerPlane.flight_at(1173) != Gone and BannerPlane.flight_at(1174) == Gone and CodeCues.file_at(1174) == \"SceneCycle.roc\"\nexpect CodeCues.file_at(JetFlyBy.enters_step) == \"JetFlyBy.roc\" and CodeCues.file_at(JetFlyBy.enters_step - 1) == \"SceneCycle.roc\"\n\nexpect CodeCues.file_at(0) == \"main.roc\" and CodeCues.file_at(49) == \"main.roc\" and CodeCues.file_at(50) == \"LanternsApp.roc\"\nexpect CodeCues.file_at(SceneCycle.cycle_steps - 1) == \"JetFlyBy.roc\"\nexpect CodeCues.showing_at(60) == { file: \"LanternsApp.roc\", page: Dark, from: 50, until: 96 }\nexpect CodeCues.showing_at(1300) == { file: \"JetFlyBy.roc\", page: Light, from: 1276, until: SceneCycle.cycle_steps }\n\nexpect CodeCues.cues.keep_if(|cue| cue.page == Light).map(|cue| cue.file) == [\"LampShapes.roc\", \"Bird.roc\", \"SceneCycle.roc\", \"JetFlyBy.roc\"]\nexpect CodeCues.showing_at(887).page == Dark and CodeCues.showing_at(888).page == Light and CodeCues.showing_at(SceneCycle.cycle_steps - 1).page == Light and CodeCues.showing_at(0).page == Dark\n\nexpect CodeCues.code_of(\"main.roc\").contains(\"program = NativeApp.program(LanternsApp.canvas_app)\")\nexpect !CodeCues.code_of(\"main.roc\").contains(\"#\")\n" },
		{ file: "CodePane.roc", code: "import CodeCues\nimport LanternsApp\nimport LanternsSources\nimport SceneCycle\nimport lib.CanvasApp\nimport lib.Input\nimport lib.Shapes\nimport lib.Skin\nimport lib.WasmApp\nimport sc.SyntaxColor\n\nCodePane :: [].{\n\n\tModel : { lanterns : LanternsApp.Model, file : Str, lines : U64, news : CodePane.News }\n\n\tNews : [NewModule, SameModule]\n\n\tCode : [ModuleSource({ file : Str, html : Str, top_line : F32, pane_lines : U32, page : CodeCues.Page }), ScrollTo(F32)]\n\n\tpane_lines : U32\n\tpane_lines = 32\n\n\tprogram : Skin.Skin -> {\n\t\tinit : {} -> Box(CodePane.Model),\n\t\tmodel_at_next_step : Box(CodePane.Model), U32, U32, U32, U32, F32, F32, F32 -> Box(CodePane.Model),\n\t\tframe_shapes : Box(CodePane.Model) -> List(Shapes.Shape),\n\t\trelease : List(Shapes.Shape) -> {},\n\t\tsounds : Box(CodePane.Model) -> U32,\n\t\ttone_count : {} -> U32,\n\t\ttone_freq : U32 -> U32,\n\t\ttone_ms : U32 -> U32,\n\t\twidth : {} -> U32,\n\t\theight : {} -> U32,\n\t\tfps : {} -> U32,\n\t\tdressing : {} -> Box(Skin.Dressing),\n\t\tcode : Box(CodePane.Model) -> Box(CodePane.Code),\n\t}\n\tprogram = |skin| {\n\t\tpage = WasmApp.program_with_skin(CodePane.canvas_app, skin)\n\t\t{\n\t\t\tinit: page.init,\n\t\t\tmodel_at_next_step: page.model_at_next_step,\n\t\t\tframe_shapes: page.frame_shapes,\n\t\t\trelease: page.release,\n\t\t\tsounds: page.sounds,\n\t\t\ttone_count: page.tone_count,\n\t\t\ttone_freq: page.tone_freq,\n\t\t\ttone_ms: page.tone_ms,\n\t\t\twidth: page.width,\n\t\t\theight: page.height,\n\t\t\tfps: page.fps,\n\t\t\tdressing: page.dressing,\n\t\t\tcode: |boxed_model| Box.box(CodePane.code(Box.unbox(boxed_model))),\n\t\t}\n\t}\n\n\tcanvas_app : CanvasApp.CanvasApp(CodePane.Model)\n\tcanvas_app = {\n\t\tsize: lanterns_app.size,\n\t\tframes_a_second: lanterns_app.frames_a_second,\n\t\tinit: module_at({ lanterns: lanterns_app.init, file: \"\", lines: 0, news: SameModule }, lanterns_app.init),\n\t\tmodel_at_next_step: CodePane.model_at_next_step,\n\t\tframe_shapes: |model| lanterns_frame_shapes(model.lanterns),\n\t\tsounds: |model| lanterns_sounds(model.lanterns),\n\t\ttones: lanterns_app.tones,\n\t\ttitle: lanterns_app.title,\n\t\tcontrols: lanterns_app.controls,\n\t}\n\n\tmodel_at_next_step : CodePane.Model, Input.Snapshot, F32 -> CodePane.Model\n\tmodel_at_next_step = |model, input, seconds| module_at(model, lanterns_step(model.lanterns, input, seconds))\n\n\tcode : CodePane.Model -> CodePane.Code\n\tcode = |model| {\n\t\tsteps = model.lanterns.scene.steps\n\t\ttop_line = top_line_at({ steps, lines: model.lines })\n\t\tmatch model.news {\n\t\t\tNewModule => ModuleSource({ file: model.file, html: SyntaxColor.html(SyntaxColor.roc, CodeCues.code_of(model.file)), top_line, pane_lines: CodePane.pane_lines, page: CodeCues.showing_at(steps).page })\n\t\t\tSameModule => ScrollTo(top_line)\n\t\t}\n\t}\n}\n\nmodule_at : CodePane.Model, LanternsApp.Model -> CodePane.Model\nmodule_at = |model, lanterns| {\n\tfile = CodeCues.file_at(lanterns.scene.steps)\n\tif file == model.file {\n\t\t{ ..model, lanterns, news: SameModule }\n\t} else {\n\t\t{ lanterns, file, lines: line_count(CodeCues.code_of(file)), news: NewModule }\n\t}\n}\n\nline_count : Str -> U64\nline_count = |code| code.to_utf8().count_if(|byte| byte == '\\n')\n\nhold_steps : U64\nhold_steps = 20\n\ncrawl_steps_a_line : U64\ncrawl_steps_a_line = 16\n\ntop_line_at : { steps : U64, lines : U64 } -> F32\ntop_line_at = |{ steps, lines }| {\n\tshowing = CodeCues.showing_at(steps)\n\tshown = CodePane.pane_lines.to_u64()\n\troom = if lines > shown {\n\t\tlines - shown\n\t} else {\n\t\t0\n\t}\n\tspan = showing.until - showing.from\n\thold = hold_steps.min(span // 4)\n\tinto = steps - showing.from\n\tif room == 0 or into <= hold {\n\t\t0.0\n\t} else if into + 1 >= span {\n\t\troom.to_f32()\n\t} else {\n\t\tscrolling = span - hold - 1\n\t\tif room * crawl_steps_a_line < scrolling {\n\t\t\t((2 * room * (into - hold) + scrolling) // (2 * scrolling)).to_f32()\n\t\t} else {\n\t\t\troom.to_f32() * (into - hold).to_f32() / scrolling.to_f32()\n\t\t}\n\t}\n}\n\nlanterns_app : CanvasApp.CanvasApp(LanternsApp.Model)\nlanterns_app = LanternsApp.canvas_app\n\nlanterns_step : LanternsApp.Model, Input.Snapshot, F32 -> LanternsApp.Model\nlanterns_step = lanterns_app.model_at_next_step\n\nlanterns_frame_shapes : LanternsApp.Model -> List(Shapes.Shape)\nlanterns_frame_shapes = lanterns_app.frame_shapes\n\nlanterns_sounds : LanternsApp.Model -> U32\nlanterns_sounds = lanterns_app.sounds\n\nplayed : U64 -> CodePane.Model\nplayed = |count| {\n\tvar \$model = CodePane.canvas_app.init\n\tfor _step in 0..<count {\n\t\t\$model = CodePane.model_at_next_step(\$model, Input.none, 0.0)\n\t}\n\t\$model\n}\n\nexpect {\n\tfirst = CodePane.canvas_app.init\n\tstepped = CodePane.model_at_next_step(first, Input.none, 0.0)\n\tfirst.file == \"main.roc\" and first.lines == 12\n\t\tand CodePane.code(first) == ModuleSource({ file: \"main.roc\", html: SyntaxColor.html(SyntaxColor.roc, CodeCues.code_of(\"main.roc\")), top_line: 0.0, pane_lines: 32, page: Dark })\n\t\tand stepped.lanterns == lanterns_step(first.lanterns, Input.none, 0.0)\n\t\tand stepped.file == \"main.roc\" and CodePane.code(stepped) == ScrollTo(0.0)\n}\n\nexpect {\n\tmodel = played(50)\n\tafter = CodePane.model_at_next_step(model, Input.none, 0.0)\n\tmodel.lanterns.scene.steps == 50 and model.file == \"LanternsApp.roc\" and model.news == NewModule\n\t\tand (\n\t\t\tmatch CodePane.code(model) {\n\t\t\t\tModuleSource(arrival) => arrival.file == \"LanternsApp.roc\" and arrival.top_line == 0.0\n\t\t\t\tScrollTo(_) => Bool.False\n\t\t\t}\n\t\t)\n\t\tand after.news == SameModule and CodePane.code(after) == ScrollTo(0.0)\n}\n\nexpect CodeCues.cues.all(\n\t|cue| {\n\t\tshowing = CodeCues.showing_at(cue.step)\n\t\tlines = line_count(CodeCues.code_of(cue.file))\n\t\tend = if lines > 32 {\n\t\t\t(lines - 32).to_f32()\n\t\t} else {\n\t\t\t0.0\n\t\t}\n\t\tvar \$backward = 0\n\t\tvar \$last = 0.0\n\t\tfor steps in showing.from..<showing.until {\n\t\t\tnow = top_line_at({ steps, lines })\n\t\t\t\$backward = if now < \$last {\n\t\t\t\t\$backward + 1\n\t\t\t} else {\n\t\t\t\t\$backward\n\t\t\t}\n\t\t\t\$last = now\n\t\t}\n\t\ttop_line_at({ steps: showing.from, lines }) == 0.0\n\t\t\tand top_line_at({ steps: showing.until - 1, lines }) == end\n\t\t\tand \$backward == 0\n\t},\n)\n\nexpect {\n\tlines = line_count(CodeCues.code_of(\"BannerPlane.roc\"))\n\thalfway = top_line_at({ steps: 512, lines })\n\tlines > 100 and halfway > 0.0 and halfway < (lines - 32).to_f32()\n}\n\ntops_through : { from : U64, lines : U64 } -> List(F32)\ntops_through = |{ from, lines }| {\n\tshowing = CodeCues.showing_at(from)\n\tvar \$tops = []\n\tfor steps in showing.from..<showing.until {\n\t\tnow = top_line_at({ steps, lines })\n\t\t\$tops = if \$tops.last() == Ok(now) {\n\t\t\t\$tops\n\t\t} else {\n\t\t\t\$tops.append(now)\n\t\t}\n\t}\n\t\$tops\n}\n\nexpect line_count(CodeCues.code_of(\"Bird.roc\")) == 33 and tops_through({ from: 1020, lines: 33 }) == [0.0, 1.0]\nexpect CodeCues.cues.all(|cue| tops_through({ from: cue.step, lines: 33 }) == [0.0, 1.0] and tops_through({ from: cue.step, lines: 34 }) == [0.0, 1.0, 2.0])\n\nexpect {\n\tmid = played(150)\n\trestarted = CodePane.model_at_next_step(mid, Input.none.with_key_pressed(KeyR), 0.0)\n\tpaused = CodePane.model_at_next_step(mid, Input.none.with_key_pressed(KeySpace), 0.0)\n\tstill = CodePane.model_at_next_step(paused, Input.none, 0.0)\n\tmid.file == \"BirdFlight.roc\"\n\t\tand restarted.file == \"main.roc\" and restarted.news == NewModule\n\t\tand paused.file == \"BirdFlight.roc\" and paused.news == SameModule\n\t\tand CodePane.code(still) == CodePane.code(paused) and CodePane.code(paused) == ScrollTo(top_line_at({ steps: 150, lines: mid.lines }))\n}\nexpect {\n\tskipped = CodePane.model_at_next_step(played(180), Input.none.with_key_pressed(KeyRight), 0.0)\n\tridden = played(246)\n\tskipped.lanterns.scene.steps == 246 and skipped.file == \"Sunrise.roc\" and skipped.news == NewModule\n\t\tand (\n\t\t\tmatch CodePane.code(skipped) {\n\t\t\t\tModuleSource(arrival) => ScrollTo(arrival.top_line) == CodePane.code(ridden) and arrival.top_line > 0.0\n\t\t\t\tScrollTo(_) => Bool.False\n\t\t\t}\n\t\t)\n}\n\npage_of : CodePane.Model -> [Arrived(CodeCues.Page), NoArrival]\npage_of = |model|\n\tmatch CodePane.code(model) {\n\t\tModuleSource(arrival) => Arrived(arrival.page)\n\t\tScrollTo(_) => NoArrival\n\t}\n\nexpect {\n\tday = played(1100)\n\trestarted = CodePane.model_at_next_step(day, Input.none.with_key_pressed(KeyR), 0.0)\n\tinto_day = CodePane.model_at_next_step(played(870), Input.none.with_key_pressed(KeyRight), 0.0)\n\tpast_rewind = CodePane.model_at_next_step(played(1300), Input.none.with_key_pressed(KeyRight), 0.0)\n\tday.file == \"Bird.roc\" and page_of(restarted) == Arrived(Dark)\n\t\tand into_day.file == \"LampShapes.roc\" and page_of(into_day) == Arrived(Light)\n\t\tand page_of(past_rewind) == Arrived(Dark)\n}\nexpect LanternsSources.modules.all(|bundled| !SyntaxColor.spans(SyntaxColor.roc, bundled.code).any(|span| span.class == Comment))\n" },
		{ file: "Easing.roc", code: "import lib.Fraction\n\nEasing :: [].{\n\n\tlerp : {\n\t\tfrom : F64,\n\t\tto : F64,\n\t\tfraction : Fraction,\n\t} -> F64\n\tlerp = |{ from, to, fraction }| from + (to - from) * fraction.to_f64()\n\n\tsmoothstep : Fraction -> Fraction\n\tsmoothstep = |fraction| {\n\t\tt = fraction.to_f64()\n\t\tFraction.of(t * t * (3.0 - 2.0 * t))\n\t}\n\n}\n\nexpect\n\t[\n\t\t(0.25, 3.0),\n\t\t(0.0, 2.0),\n\t\t(1.0, 6.0),\n\t\t(0.75, 5.0),\n\t].all(\n\t\t|(ratio, value)| {\n\t\t\tgot = Easing.lerp({\n\t\t\t\tfrom: 2.0,\n\t\t\t\tto: 6.0,\n\t\t\t\tfraction: Fraction.of(ratio),\n\t\t\t})\n\t\t\tgot == value\n\t\t},\n\t)\n\nexpect\n\t[\n\t\t(0.0, 0.0),\n\t\t(0.25, 0.15625),\n\t\t(0.5, 0.5),\n\t\t(0.75, 0.84375),\n\t\t(1.0, 1.0),\n\t].all(|(ratio, eased)| Easing.smoothstep(Fraction.of(ratio)).to_f64() == eased)\n" },
		{ file: "JetFlyBy.roc", code: "import RoadCamera\nimport lib.Brush\nimport lib.Point\nimport lib.RgbColor\nimport lib.Shapes\n\nJetFlyBy :: [].{\n\n\tDrawnJet : { forward : F64, shapes : List(Shapes.Shape) }\n\n\tjets_at : U64 -> List(JetFlyBy.DrawnJet)\n\tjets_at = |steps|\n\t\tmatch flown_at(steps) {\n\t\t\tFlown(flown) => formation_slots.map(|slot| drawn_jet(flown, slot))\n\t\t\tComing => []\n\t\t\tGone => []\n\t\t}\n\n\tenters_step : U64\n\tenters_step = 1276\n\n\tends_step : U64\n\tends_step = 1340\n}\n\nPlace : {\n\talong : F64,\n\tacross : F64,\n\tlift : F64,\n}\n\nFlight : [\n\tComing,\n\tFlown({ metres : F64, alpha : F64 }),\n\tGone,\n]\n\nflown_at : U64 -> Flight\nflown_at = |steps|\n\tif steps < JetFlyBy.enters_step {\n\t\tComing\n\t} else if steps >= JetFlyBy.ends_step {\n\t\tGone\n\t} else {\n\t\tinto = (steps - JetFlyBy.enters_step).to_f64()\n\t\tleft = (JetFlyBy.ends_step - steps).to_f64()\n\t\tFlown({ metres: speed * into, alpha: (left / fade_steps.to_f64()).min(1.0) })\n\t}\n\nspeed : F64\nspeed = 10.0\n\nfade_steps : U64\nfade_steps = 14\n\nview_camera : RoadCamera\nview_camera = RoadCamera.at({ along: 0.0, across: 0.0 })\n\nstart_place : Place\nstart_place = {\n\talong: 55.0,\n\tacross: -2.0,\n\tlift: 49.0,\n}\n\nheading_step : Place\nheading_step = {\n\talong: 1.0,\n\tacross: 0.3,\n\tlift: 0.53,\n}\n\nheading : Place\nheading = unit(heading_step)\n\nlevel_heading : Place\nlevel_heading = unit({ ..heading_step, lift: 0.0 })\n\nright_hand : Place\nright_hand = unit({\n\talong: 0.0 - heading_step.across,\n\tacross: heading_step.along,\n\tlift: 0.0,\n})\n\nunit : Place -> Place\nunit = |place| {\n\tlength = length_of(place)\n\t{\n\t\talong: place.along / length,\n\t\tacross: place.across / length,\n\t\tlift: place.lift / length,\n\t}\n}\n\nlength_of : Place -> F64\nlength_of = |{ along, across, lift }| (along * along + across * across + lift * lift).sqrt()\n\noffset_place : Place, { ahead : F64, out : F64 } -> Place\noffset_place = |place, { ahead, out }| {\n\talong: place.along + ahead * level_heading.along + out * right_hand.along,\n\tacross: place.across + ahead * level_heading.across + out * right_hand.across,\n\tlift: place.lift,\n}\n\nlead_place : F64 -> Place\nlead_place = |metres| {\n\talong: start_place.along + metres * heading.along,\n\tacross: start_place.across + metres * heading.across,\n\tlift: start_place.lift + metres * heading.lift,\n}\n\nformation_slots : List({ ahead : F64, out : F64 })\nformation_slots = [\n\t{ ahead: 0.0, out: 0.0 },\n\t{ ahead: -13.0, out: -12.0 },\n\t{ ahead: -13.0, out: 12.0 },\n\t{ ahead: -26.0, out: -24.0 },\n\t{ ahead: -26.0, out: 24.0 },\n]\n\noutline_offsets : List((F64, F64))\noutline_offsets = [\n\t(8.6, 0.0),\n\t(6.4, 0.6),\n\t(3.0, 1.0),\n\t(-3.0, 5.8),\n\t(-4.6, 5.8),\n\t(-4.0, 1.3),\n\t(-5.8, 1.3),\n\t(-8.0, 3.4),\n\t(-9.2, 3.4),\n\t(-8.8, 0.7),\n\t(-9.4, 0.0),\n\t(-8.8, -0.7),\n\t(-9.2, -3.4),\n\t(-8.0, -3.4),\n\t(-5.8, -1.3),\n\t(-4.0, -1.3),\n\t(-4.6, -5.8),\n\t(-3.0, -5.8),\n\t(3.0, -1.0),\n\t(6.4, -0.6),\n]\n\ntrim_offsets : List(List((F64, F64)))\ntrim_offsets = [\n\t[\n\t\t(7.2, 0.3),\n\t\t(-8.6, 0.3),\n\t\t(-8.6, -0.3),\n\t\t(7.2, -0.3),\n\t],\n\t[\n\t\t(3.0, 1.0),\n\t\t(-3.0, 5.8),\n\t\t(-3.7, 5.8),\n\t\t(2.0, 1.0),\n\t],\n\t[\n\t\t(3.0, -1.0),\n\t\t(-3.0, -5.8),\n\t\t(-3.7, -5.8),\n\t\t(2.0, -1.0),\n\t],\n]\n\ntrail_offsets : F64 -> List((F64, F64))\ntrail_offsets = |metres| {\n\tlength = (metres / 2.0).min(trail_length)\n\t[\n\t\t(-9.4, 0.6),\n\t\t(-9.4 - length, 0.0),\n\t\t(-9.4, -0.6),\n\t]\n}\n\ntrail_length : F64\ntrail_length = 40.0\n\nbody_color : RgbColor\nbody_color = RgbColor.of(0x10307A)\n\ntrim_color : RgbColor\ntrim_color = RgbColor.of(0xF2C230)\n\ntrail_color : RgbColor\ntrail_color = RgbColor.of(0xF4F4F8)\n\ntrail_alpha : F64\ntrail_alpha = 0.45\n\ndrawn_jet : { metres : F64, alpha : F64 }, { ahead : F64, out : F64 } -> JetFlyBy.DrawnJet\ndrawn_jet = |{ metres, alpha }, slot| {\n\tmiddle = offset_place(lead_place(metres), slot)\n\tpart = |offsets, fill| jet_part({ middle, offsets, fill })\n\tfill_of = |color, strength|\n\t\tif strength >= 1.0 {\n\t\t\tBrush.flat(color)\n\t\t} else {\n\t\t\tFlat(Brush.with_alpha(color, strength))\n\t\t}\n\ttrail = part(trail_offsets(metres), Flat(Brush.with_alpha(trail_color, trail_alpha * alpha)))\n\tbody = part(outline_offsets, fill_of(body_color, alpha))\n\ttrims = trim_offsets.map(|offsets| part(offsets, fill_of(trim_color, alpha)))\n\t{ forward: view_camera.forward_of(middle.along), shapes: [trail, body].concat(trims) }\n}\n\njet_part : {\n\tmiddle : Place,\n\toffsets : List((F64, F64)),\n\tfill : Brush.Fill,\n} -> Shapes.Shape\njet_part = |{ middle, offsets, fill }| {\n\tcorners = offsets.map(\n\t\t|(ahead, out)|\n\t\t\tmatch view_camera.project(offset_place(middle, { ahead, out })) {\n\t\t\t\tOk(point) => point\n\t\t\t\tErr(BehindCamera) => crash \"JetFlyBy.jet_part: the path keeps every jet in front of the camera\"\n\t\t\t},\n\t)\n\tShapes.region_from_corners(corners, fill)\n}\n\nexpect JetFlyBy.jets_at(JetFlyBy.enters_step - 1) == []\nexpect JetFlyBy.jets_at(JetFlyBy.enters_step).len() == 5\nexpect JetFlyBy.jets_at(JetFlyBy.ends_step - 1).len() == 5\nexpect JetFlyBy.jets_at(JetFlyBy.ends_step) == [] and JetFlyBy.jets_at(1349) == []\nexpect JetFlyBy.enters_step == 1276 and JetFlyBy.ends_step == 1340 and JetFlyBy.ends_step < 1350\n\nexpect flown_at(JetFlyBy.ends_step - fade_steps - 1) == Flown({ metres: speed * 49.0, alpha: 1.0 })\nexpect\n\tmatch (flown_at(JetFlyBy.ends_step - 2), flown_at(JetFlyBy.ends_step - 1)) {\n\t\t(Flown(before), Flown(last)) => before.alpha > last.alpha and last.alpha > 0.0\n\t\t_ => Bool.False\n\t}\n\nexpect [heading, level_heading, right_hand].all(|direction| (length_of(direction) - 1.0).abs() < tolerance)\nexpect heading.lift > 0.0 and level_heading.lift == 0.0 and right_hand.lift == 0.0\nexpect right_hand.across > 0.0\nexpect {\n\tdot = level_heading.along * right_hand.along + level_heading.across * right_hand.across\n\tdot.abs() < tolerance\n}\n\ntolerance : F64\ntolerance = 1.0e-12\n\nexpect {\n\tvar \$shrinking = 0\n\tvar \$growing = 0\n\tvar \$sizes_before = []\n\tfor steps in JetFlyBy.enters_step..<JetFlyBy.ends_step {\n\t\tsizes = JetFlyBy.jets_at(steps).map(\n\t\t\t|jet| {\n\t\t\t\tbody = jet.shapes.get(1) ?? crash \"every jet has its outline second\"\n\t\t\t\tcorners = Shapes.region_corners(body) ?? crash \"a jet's outline has corners\"\n\t\t\t\txs = corners.map(|p| p.x.to_f64())\n\t\t\t\tys = corners.map(|p| p.y.to_f64())\n\t\t\t\twidth = xs.fold(-1.0e9.F64, |a, x| a.max(x)) - xs.fold(1.0e9.F64, |a, x| a.min(x))\n\t\t\t\theight = ys.fold(-1.0e9.F64, |a, y| a.max(y)) - ys.fold(1.0e9.F64, |a, y| a.min(y))\n\t\t\t\t(width * width + height * height).sqrt()\n\t\t\t},\n\t\t)\n\t\tfor k in 0..<\$sizes_before.len() {\n\t\t\tbefore = \$sizes_before.get(k) ?? crash \"the formation keeps its five jets\"\n\t\t\tnow = sizes.get(k) ?? crash \"the formation keeps its five jets\"\n\t\t\tif now < before {\n\t\t\t\t\$shrinking = \$shrinking + 1\n\t\t\t} else {\n\t\t\t\t\$growing = \$growing + 1\n\t\t\t}\n\t\t}\n\t\t\$sizes_before = sizes\n\t}\n\t\$shrinking == 5 * 63 and \$growing == 0\n}\n" },
		{ file: "LampShapes.roc", code: "import Lantern\nimport lib.Brush\nimport lib.ColorShade\nimport lib.Fraction\nimport lib.Pixels\nimport lib.Point\nimport lib.RgbColor\nimport lib.Shapes\nimport lib.WidthShading\n\nLampShapes :: [].{\n\n\tUpright : { foot : Point, height_on_screen : Pixels }\n\n\tlamp_shapes : LampShapes.Upright, { lantern : Lantern, day : Fraction } -> List(Shapes.Shape)\n\tlamp_shapes = |upright, { lantern, day }| {\n\t\th = upright.height_on_screen.to_f64()\n\t\tx = upright.foot.x.to_f64()\n\t\ttop = upright.foot.y.to_f64() - h\n\t\tglobe_radius = h * globe_share\n\t\tcap_height = h * cap_share\n\t\tglobe_y = top + cap_height + globe_radius\n\t\tglow = lantern.glow_color()\n\t\thalo = Shapes.halo(\n\t\t\t{ center: Point.at(x, globe_y), radius: Pixels.of(globe_radius * halo_reach) },\n\t\t\tBrush.with_alpha(glow, 0.48 - 0.2 * day.to_f64()),\n\t\t)\n\t\tpost_half = (h * post_share / 2.0).max(0.5)\n\t\tpost_left = Pixels.of(x - post_half)\n\t\tpost_right = Pixels.of(x + post_half)\n\t\tpost = Shapes.rectangle({\n\t\t\ttop_left: { x: post_left, y: Pixels.of(globe_y) },\n\t\t\twidth: post_right.minus(post_left),\n\t\t\theight: Pixels.of(upright.foot.y.to_f64() - globe_y),\n\t\t\tfill: WidthShading.width_shade({ min_x: post_left, max_x: post_right }, { color: iron_color, strength: Fraction.whole }),\n\t\t})\n\t\tcap_half = globe_radius * 1.25\n\t\tcap = Quad({\n\t\t\tfirst: Point.at(x - globe_radius * 0.35, top),\n\t\t\tsecond: Point.at(x + globe_radius * 0.35, top),\n\t\t\tthird: Point.at(x + cap_half, top + cap_height),\n\t\t\tfourth: Point.at(x - cap_half, top + cap_height),\n\t\t\tfill: Brush.flat(iron_color),\n\t\t})\n\t\tglobe = Disc({\n\t\t\tcenter: Point.at(x, globe_y),\n\t\t\tradius: Pixels.of(globe_radius),\n\t\t\tfill: globe_fill({ x, y: globe_y, radius: globe_radius }, glow),\n\t\t})\n\t\t[halo, post, cap, globe]\n\t}\n}\n\nglobe_share : F64\nglobe_share = 0.065\n\ncap_share : F64\ncap_share = 0.04\n\npost_share : F64\npost_share = 0.03\n\nhalo_reach : F64\nhalo_reach = 5.5\n\niron_color : RgbColor\niron_color = RgbColor.of(0x2E3340)\n\nglobe_fill : { x : F64, y : F64, radius : F64 }, RgbColor -> Brush.Fill\nglobe_fill = |{ x, y, radius }, glow| {\n\thot = ColorShade.color_between({ from: glow, to: RgbColor.of(0xFFFFFF), fraction: Fraction.of(0.75) })\n\trim = ColorShade.shade_color(glow, Darkened(Fraction.of(0.3)))\n\tstops = {\n\t\tstart_color: Brush.opaque_rgba(hot),\n\t\tend_color: Brush.opaque_rgba(rim),\n\t\tstart_offset: 0.1,\n\t\tend_offset: 1.0,\n\t}\n\tlook = {\n\t\tstops,\n\t\tcenter: Point.at(x - radius * 0.3, y - radius * 0.3),\n\t\taxis_u: Point.at(radius * 1.3, 0.0),\n\t\taxis_v: Point.at(0.0, radius * 1.3),\n\t}\n\tmatch Brush.elliptical_gradient(look) {\n\t\tOk(fill) => fill\n\t\tErr(TooThin) => Brush.flat(glow)\n\t}\n}\n\nexpect {\n\tshapes = LampShapes.lamp_shapes({ foot: Point.at(480.0, 500.0), height_on_screen: Pixels.of(200.0) }, { lantern: Lantern.Amber, day: Fraction.zero })\n\ttop_y =\n\t\tmatch shapes.get(2) {\n\t\t\tOk(Quad(q)) => q.first.y.to_f64()\n\t\t\t_ => crash \"a lamp's third shape is its cap\"\n\t\t}\n\tshapes.len() == 4 and top_y == 300.0\n}\n" },
		{ file: "Lantern.roc", code: "import lib.RgbColor\n\nLantern := [Amber, Rose, Mint].{\n\n\theight_metres : Lantern -> F64\n\theight_metres = |lantern|\n\t\tmatch lantern {\n\t\t\tAmber => 6.0\n\t\t\tRose => 6.8\n\t\t\tMint => 5.4\n\t\t}\n\n\tglow_color : Lantern -> RgbColor\n\tglow_color = |lantern|\n\t\tmatch lantern {\n\t\t\tAmber => RgbColor.of(0xFFC46B)\n\t\t\tRose => RgbColor.of(0xFF8FA3)\n\t\t\tMint => RgbColor.of(0x9FF2CF)\n\t\t}\n\n\tis_eq : _\n}\n\nexpect Lantern.Rose.height_metres() > Lantern.Amber.height_metres()\nexpect Lantern.Mint.height_metres() < Lantern.Amber.height_metres()\nexpect Lantern.Amber.glow_color() == RgbColor.of(0xFFC46B)\n" },
		{ file: "LanternsApp.roc", code: "import BackdropShapes\nimport BannerPlane\nimport Bird\nimport BirdFlight\nimport JetFlyBy\nimport RoadCamera\nimport RoadLamps\nimport RoadsideShapes\nimport SceneCycle\nimport Sunrise\nimport lib.CanvasApp\nimport lib.Input\nimport lib.Shapes\n\nLanternsApp :: [].{\n\tModel : { scene : SceneCycle.Scene, play : LanternsApp.Play }\n\n\tPlay : [Playing, Paused]\n\n\tcanvas_app : CanvasApp.CanvasApp(LanternsApp.Model)\n\tcanvas_app = {\n\t\tsize: { width: RoadCamera.screen_width, height: RoadCamera.screen_height },\n\t\tframes_a_second: 30,\n\t\tinit: first_model,\n\t\tmodel_at_next_step: CanvasApp.untimed_model_at_next_step(model_at_next_step),\n\t\tframe_shapes: LanternsApp.frame_shapes,\n\t\tsounds: |_model| 0,\n\t\ttones: [],\n\t\ttitle: \"Lanterns\",\n\t\tcontrols: [\n\t\t\t{ keys: \"Space\", does: \"pauses and resumes\" },\n\t\t\t{ keys: \"R\", does: \"restarts at dawn\" },\n\t\t\t{ keys: \"→\", does: \"skips ahead a crossing\" },\n\t\t],\n\t}\n\n\tframe_shapes : LanternsApp.Model -> List(Shapes.Shape)\n\tframe_shapes = |model| {\n\t\t{ flight, steps_into_leg, steps } = model.scene\n\t\tcamera = SceneCycle.camera_at(steps)\n\t\tday = SceneCycle.day_at(steps)\n\t\tlight = Sunrise.light_at(day)\n\t\tlamps = RoadLamps.lamps_between({\n\t\t\tnearest: camera.along() + RoadCamera.near_plane,\n\t\t\tfarthest: camera.along() + view_depth,\n\t\t})\n\t\tdrawn_lamps = lamps.keep_oks(|lamp| RoadsideShapes.drawn_lamp(camera, { lamp, day }))\n\t\tbird = flight.bird_instant_at(SceneCycle.flight_stage(steps_into_leg))\n\t\tdrawn_bird = RoadsideShapes.drawn_birds(camera, { bird, flight })\n\t\tdrawn_jets = JetFlyBy.jets_at(steps)\n\t\tby_distance = drawn_lamps.concat(drawn_bird).concat(drawn_jets).sort_with(\n\t\t\t|first, second|\n\t\t\t\tif first.forward > second.forward {\n\t\t\t\t\tBefore\n\t\t\t\t} else if first.forward < second.forward {\n\t\t\t\t\tAfter\n\t\t\t\t} else {\n\t\t\t\t\tSame\n\t\t\t\t},\n\t\t)\n\t\tpools = lamps.join_map(|lamp| RoadsideShapes.light_pool_shapes(camera, { lamp, day }))\n\t\tplane = BannerPlane.shapes_at(steps)\n\t\tBackdropShapes.backdrop_shapes(camera, light).concat(plane).concat(pools).concat(by_distance.join_map(|drawn| drawn.shapes))\n\t}\n}\n\nfirst_model : LanternsApp.Model\nfirst_model = { scene: SceneCycle.first_scene, play: Playing }\n\nview_depth : F64\nview_depth = 400.0\n\nmodel_at_next_step : LanternsApp.Model, Input.Snapshot -> LanternsApp.Model\nmodel_at_next_step = |model, input|\n\tif input.key_pressed(KeyR) {\n\t\tfirst_model\n\t} else if input.key_pressed(KeySpace) {\n\t\t{ ..model, play: other_play(model.play) }\n\t} else if input.key_pressed(KeyRight) {\n\t\t{ ..model, scene: SceneCycle.scene_after(model.scene, SceneCycle.leg_steps) }\n\t} else {\n\t\tmatch model.play {\n\t\t\tPlaying => { ..model, scene: SceneCycle.scene_at_next_step(model.scene) }\n\t\t\tPaused => model\n\t\t}\n\t}\n\nother_play : LanternsApp.Play -> LanternsApp.Play\nother_play = |play|\n\tmatch play {\n\t\tPlaying => Paused\n\t\tPaused => Playing\n\t}\n\nmid_model : LanternsApp.Model\nmid_model = { scene: SceneCycle.scene_after(SceneCycle.first_scene, 100), play: Playing }\n\nspace : Input.Snapshot\nspace = Input.none.with_key_pressed(KeySpace)\n\nexpect {\n\tstepped = { ..mid_model, scene: SceneCycle.scene_at_next_step(mid_model.scene) }\n\tmodel_at_next_step(mid_model, Input.none) == stepped\n\t\tand stepped != mid_model\n\t\tand model_at_next_step(mid_model, Input.none.with_key_down(KeySpace)) == stepped\n\t\tand model_at_next_step(mid_model, Input.none.with_key_down(KeyR)) == stepped\n\t\tand model_at_next_step(mid_model, Input.none.with_key_down(KeyRight)) == stepped\n\t\tand model_at_next_step(mid_model, Input.none.with_key_pressed(KeyLeft)) == stepped\n}\n\nexpect {\n\tpaused = model_at_next_step(mid_model, space)\n\tresumed = model_at_next_step(paused, space)\n\tpaused.play == Paused\n\t\tand paused.scene == mid_model.scene\n\t\tand resumed == mid_model\n\t\tand model_at_next_step(resumed, Input.none).scene == SceneCycle.scene_at_next_step(mid_model.scene)\n}\n\nexpect {\n\tpaused = { ..mid_model, play: Paused }\n\tmodel_at_next_step(paused, Input.none) == paused\n\t\tand model_at_next_step(paused, Input.none.with_key_down(KeySpace)) == paused\n\t\tand model_at_next_step(model_at_next_step(paused, Input.none), Input.none) == paused\n}\n\nexpect {\n\tr_key = Input.none.with_key_pressed(KeyR)\n\tmodel_at_next_step(mid_model, r_key) == first_model\n\t\tand model_at_next_step({ ..mid_model, play: Paused }, r_key) == first_model\n\t\tand model_at_next_step(first_model, r_key) == first_model\n\t\tand first_model.play == Playing\n\t\tand model_at_next_step(mid_model, Input.none.with_key_down(KeyR)) != first_model\n}\n\nexpect {\n\tright = Input.none.with_key_pressed(KeyRight)\n\tskipped = model_at_next_step(mid_model, right)\n\tpaused_skip = model_at_next_step({ ..mid_model, play: Paused }, right)\n\tskipped.play == Playing\n\t\tand skipped.scene.steps == 166\n\t\tand skipped.scene.steps_into_leg == mid_model.scene.steps_into_leg\n\t\tand skipped.scene.flight == mid_model.scene.flight.next()\n\t\tand paused_skip.play == Paused\n\t\tand paused_skip.scene == skipped.scene\n}\n\nexpect {\n\tright = Input.none.with_key_pressed(KeyRight)\n\tskip_from = |steps| model_at_next_step({ scene: SceneCycle.scene_after(SceneCycle.first_scene, steps), play: Playing }, right).scene\n\tnear_end = skip_from(SceneCycle.cycle_steps - 10)\n\tnear_end.steps == 56\n\t\tand near_end.steps_into_leg == 56\n\t\tand near_end.flight == BirdFlight.first\n\t\tand skip_from(SceneCycle.cycle_steps - SceneCycle.leg_steps) == SceneCycle.first_scene\n\t\tand skip_from(SceneCycle.cycle_steps - SceneCycle.leg_steps - 1).steps == SceneCycle.cycle_steps - 1\n}\n\nexpect {\n\tvar \$model = first_model\n\tvar \$in_view = 0\n\tvar \$touches = 0\n\tvar \$first_in_view = SceneCycle.cycle_steps\n\tvar \$last_in_view = 0.U64\n\tfor _step in 0..<SceneCycle.cycle_steps {\n\t\tsteps = \$model.scene.steps\n\t\tplane_corners = BannerPlane.shapes_at(steps).join_map(|shape| Shapes.region_corners(shape) ?? crash \"every part of the plane has corners\")\n\t\tif !plane_corners.is_empty() {\n\t\t\tleft = plane_corners.fold(1.0e9, |least, corner| least.min(corner.x.to_f64()))\n\t\t\tright = plane_corners.fold(-1.0e9, |most, corner| most.max(corner.x.to_f64()))\n\t\t\ttop = plane_corners.fold(1.0e9, |least, corner| least.min(corner.y.to_f64()))\n\t\t\tbottom = plane_corners.fold(-1.0e9, |most, corner| most.max(corner.y.to_f64()))\n\t\t\tbird_clear =\n\t\t\t\tmatch bird_drawing_top(\$model.scene) {\n\t\t\t\t\tTop(bird_top) => bottom + 20.0 < bird_top\n\t\t\t\t\tUnseen => Bool.True\n\t\t\t\t}\n\t\t\tsun = Sunrise.light_at(SceneCycle.day_at(steps)).sun_center\n\t\t\tsun_radius = Sunrise.sun_radius.to_f64()\n\t\t\tsun_clear = bottom < sun.y.to_f64() - sun_radius or top > sun.y.to_f64() + sun_radius or right < sun.x.to_f64() - sun_radius or left > sun.x.to_f64() + sun_radius\n\t\t\t\$in_view = \$in_view + 1\n\t\t\t\$first_in_view = \$first_in_view.min(steps)\n\t\t\t\$last_in_view = \$last_in_view.max(steps)\n\t\t\t\$touches =\n\t\t\t\tif bird_clear and sun_clear and top >= 0.0 {\n\t\t\t\t\t\$touches\n\t\t\t\t} else {\n\t\t\t\t\t\$touches + 1\n\t\t\t\t}\n\t\t} else {\n\t\t\t{}\n\t\t}\n\t\t\$model = model_at_next_step(\$model, Input.none)\n\t}\n\t\$touches == 0 and \$in_view == 774 and \$first_in_view == 400 and \$last_in_view == 1173\n}\n\nexpect {\n\tridge_top = Sunrise.far_range_corners.fold(1.0e9, |least, corner| least.min(corner.y.to_f64()))\n\tvar \$model = first_model\n\tvar \$in_view = 0\n\tvar \$fives = 0\n\tvar \$touches = 0\n\tvar \$first_in_view = SceneCycle.cycle_steps\n\tvar \$last_in_view = 0.U64\n\tfor _step in 0..<SceneCycle.cycle_steps {\n\t\tsteps = \$model.scene.steps\n\t\tjets = JetFlyBy.jets_at(steps)\n\t\tif !jets.is_empty() {\n\t\t\tjet_shapes = jets.join_map(|jet| jet.shapes)\n\t\t\tcorners = jet_shapes.join_map(|shape| Shapes.region_corners(shape) ?? crash \"every part of a jet has corners\")\n\t\t\tbottom = corners.fold(-1.0e9, |most, corner| most.max(corner.y.to_f64()))\n\t\t\ton_screen = corners.any(|corner| corner.x.to_f64() >= 0.0 and corner.x.to_f64() <= RoadCamera.screen_width and corner.y.to_f64() >= 0.0)\n\t\t\tbird_clear =\n\t\t\t\tmatch bird_drawing_top(\$model.scene) {\n\t\t\t\t\tTop(bird_top) => bottom + 20.0 < bird_top\n\t\t\t\t\tUnseen => Bool.True\n\t\t\t\t}\n\t\t\t\$in_view = \$in_view + 1\n\t\t\t\$first_in_view = \$first_in_view.min(steps)\n\t\t\t\$last_in_view = \$last_in_view.max(steps)\n\t\t\t\$fives =\n\t\t\t\tif jets.len() == 5 {\n\t\t\t\t\t\$fives + 1\n\t\t\t\t} else {\n\t\t\t\t\t\$fives\n\t\t\t\t}\n\t\t\t\$touches =\n\t\t\t\tif bird_clear and bottom < ridge_top and on_screen {\n\t\t\t\t\t\$touches\n\t\t\t\t} else {\n\t\t\t\t\t\$touches + 1\n\t\t\t\t}\n\t\t} else {\n\t\t\t{}\n\t\t}\n\t\t\$model = model_at_next_step(\$model, Input.none)\n\t}\n\t\$touches == 0 and \$in_view == 64 and \$fives == 64\n\t\tand \$first_in_view == 1276 and \$last_in_view == 1339\n}\n\nexpect {\n\tjet_shapes = JetFlyBy.jets_at(1300).join_map(|jet| jet.shapes)\n\tframe = LanternsApp.frame_shapes({ scene: SceneCycle.scene_after(SceneCycle.first_scene, 1300), play: Playing })\n\tjet_shapes.len() == 25 and jet_shapes.all(|shape| frame.contains(shape))\n}\n\nbird_drawing_top : SceneCycle.Scene -> [Top(F64), Unseen]\nbird_drawing_top = |{ flight, steps_into_leg, steps }| {\n\tcamera = SceneCycle.camera_at(steps)\n\tbird = flight.bird_instant_at(SceneCycle.flight_stage(steps_into_leg))\n\tgap = bird.location.along - camera.along()\n\tbird_corners = Bird.pose_still(bird.pose).polygons().join_map(|polygon| polygon.points)\n\tbird_rise = bird_corners.fold(0.0, |most, corner| most.max(corner.y))\n\tbird_height = RoadCamera.size_on_screen({ height: Bird.height_metres, forward: gap }).to_f64()\n\tmatch camera.project(bird.location) {\n\t\tOk(foot) => Top(foot.y.to_f64() - bird_height * bird_rise)\n\t\tErr(BehindCamera) => Unseen\n\t}\n}\n\nexpect {\n\tplane = BannerPlane.shapes_at(700)\n\tframe = LanternsApp.frame_shapes({ scene: SceneCycle.scene_after(SceneCycle.first_scene, 700), play: Playing })\n\tplane.len() > 20 and plane.all(|shape| frame.contains(shape))\n}\nexpect {\n\tright = Input.none.with_key_pressed(KeyRight)\n\tbefore = { scene: SceneCycle.scene_after(SceneCycle.first_scene, 380), play: Playing }\n\tskipped = model_at_next_step(before, right)\n\tBannerPlane.flight_at(before.scene.steps) == Coming and BannerPlane.flight_at(skipped.scene.steps) != Coming\n}\n\nexpect LanternsApp.frame_shapes({ scene: { flight: BirdFlight.first, steps_into_leg: 40, steps: 40 }, play: Playing }).len() > 50\n" },
		{ file: "RoadCamera.roc", code: "import lib.Pixels\nimport lib.Point\n\nRoadCamera :: { along : F64, across : F64, height : F64 }.{\n\n\tat : { along : F64, across : F64 } -> RoadCamera\n\tat = |{ along: along_road, across }| RoadCamera.({ along: along_road, across, height: camera_height })\n\n\talong : RoadCamera -> F64\n\talong = |RoadCamera.(camera)| camera.along\n\n\tforward_of : RoadCamera, F64 -> F64\n\tforward_of = |RoadCamera.(camera), place_along| place_along - camera.along\n\n\tproject : RoadCamera, { along : F64, across : F64, lift : F64 } -> Try(Point, [BehindCamera])\n\tproject = |RoadCamera.(camera), { along: point_along, across: point_across, lift }| {\n\t\tforward = point_along - camera.along\n\t\tif forward < near_plane {\n\t\t\tErr(BehindCamera)\n\t\t} else {\n\t\t\tOk(\n\t\t\t\tPoint.at(\n\t\t\t\t\tcenter_x + focal_length * (point_across - camera.across) / forward,\n\t\t\t\t\thorizon_y - focal_length * (lift - camera.height) / forward,\n\t\t\t\t),\n\t\t\t)\n\t\t}\n\t}\n\n\tsize_on_screen : { height : F64, forward : F64 } -> Pixels\n\tsize_on_screen = |{ height, forward }| Pixels.of(focal_length * height / forward)\n\n\tscreen_width : F64\n\tscreen_width = 960.0\n\n\tscreen_height : F64\n\tscreen_height = 600.0\n\n\thorizon_y : F64\n\thorizon_y = 380.0\n\n\tnear_plane : F64\n\tnear_plane = 1.0\n}\n\ncamera_height : F64\ncamera_height = 5.0\n\nfocal_length : F64\nfocal_length = 500.0\n\ncenter_x : F64\ncenter_x = RoadCamera.screen_width / 2.0\n\nsample_camera : RoadCamera\nsample_camera = RoadCamera.at({ along: 100.0, across: 0.0 })\n\nexpect sample_camera.project({ along: 125.0, across: 0.0, lift: 5.0 }) == Ok(Point.at(480.0, 380.0))\nexpect sample_camera.project({ along: 125.0, across: 3.0, lift: 5.0 }) == Ok(Point.at(540.0, 380.0))\nexpect sample_camera.project({ along: 125.0, across: 0.0, lift: 2.0 }) == Ok(Point.at(480.0, 440.0))\n\nexpect sample_camera.project({ along: 101.0, across: 0.0, lift: 5.0 }).is_ok()\nexpect sample_camera.project({ along: 100.5, across: 0.0, lift: 5.0 }) == Err(BehindCamera)\n" },
		{ file: "RoadLamps.roc", code: "import Lantern\n\nRoadLamps :: [].{\n\n\tSide : [Left, Right]\n\n\tRoadLamp : {\n\t\tside : RoadLamps.Side,\n\t\tplace : U64,\n\t\talong : F64,\n\t\tacross : F64,\n\t\tlantern : Lantern,\n\t}\n\n\tlamp_at : RoadLamps.Side, U64 -> RoadLamps.RoadLamp\n\tlamp_at = |side, place| {\n\t\tnudge = (unit_draw(lamp_key(side, place)) * 2.0 - 1.0) * most_nudge\n\t\tacross =\n\t\t\tmatch side {\n\t\t\t\tLeft => 0.0 - lamp_line_distance\n\t\t\t\tRight => lamp_line_distance\n\t\t\t}\n\t\t{\n\t\t\tside,\n\t\t\tplace,\n\t\t\talong: RoadLamps.even_along(place) + nudge,\n\t\t\tacross,\n\t\t\tlantern: lantern_at(place),\n\t\t}\n\t}\n\n\tlamps_between : { nearest : F64, farthest : F64 } -> List(RoadLamps.RoadLamp)\n\tlamps_between = |{ nearest, farthest }| {\n\t\tfirst_place = place_at_or_before(nearest - most_nudge)\n\t\tlast_place = place_at_or_before(farthest + most_nudge)\n\t\tis_in_range = |lamp| lamp.along >= nearest and lamp.along <= farthest\n\t\tvar \$lamps = []\n\t\tfor place in first_place..=last_place {\n\t\t\t\$lamps = \$lamps.append(RoadLamps.lamp_at(Left, place)).append(RoadLamps.lamp_at(Right, place))\n\t\t}\n\t\t\$lamps.keep_if(is_in_range)\n\t}\n\n\teven_along : U64 -> F64\n\teven_along = |place| first_along + place.to_f64() * RoadLamps.lamp_spacing\n\n\tlamp_spacing : F64\n\tlamp_spacing = 30.0\n\n\tother_side : RoadLamps.Side -> RoadLamps.Side\n\tother_side = |side|\n\t\tmatch side {\n\t\t\tLeft => Right\n\t\t\tRight => Left\n\t\t}\n\n\tmost_nudge : F64\n\tmost_nudge = 6.0\n\n\tlamp_line_distance : F64\n\tlamp_line_distance = 3.5\n}\n\nfirst_along : F64\nfirst_along = 6.0\n\npairs_a_stretch : U64\npairs_a_stretch = 6\n\nseed : U64\nseed = 20261115\n\nlantern_at : U64 -> Lantern\nlantern_at = |place|\n\tif place % 2 == 0 {\n\t\tLantern.Amber\n\t} else if draw((place // pairs_a_stretch) * 2 + 1) % 2 == 0 {\n\t\tLantern.Rose\n\t} else {\n\t\tLantern.Mint\n\t}\n\nlamp_key : RoadLamps.Side, U64 -> U64\nlamp_key = |side, place|\n\tmatch side {\n\t\tLeft => place * 4\n\t\tRight => place * 4 + 2\n\t}\n\nplace_at_or_before : F64 -> U64\nplace_at_or_before = |along| {\n\tsteps = (along - first_along) / RoadLamps.lamp_spacing\n\tif steps <= 0.0 {\n\t\t0\n\t} else {\n\t\tsteps.floor_to_u64_try() ?? crash \"RoadLamps.place_at_or_before: a road longer than a U64 of places\"\n\t}\n}\n\nmask : U64\nmask = 4294967295\n\nturn : U64 -> U64\nturn = |n| (n.bitwise_and(mask) * 1664525 + 1013904223).bitwise_and(mask)\n\ndraw : U64 -> U64\ndraw = |key| turn(turn(turn(seed + key))).shr_wrap(8)\n\nunit_draw : U64 -> F64\nunit_draw = |key| draw(key).to_f64() / 16777216.0\n\nexpect RoadLamps.lamp_at(Left, 7) == RoadLamps.lamp_at(Left, 7)\n\nexpect\n\t[0, 1, 2, 3, 50, 1000].all(\n\t\t|place| {\n\t\t\tleft = RoadLamps.lamp_at(Left, place)\n\t\t\tright = RoadLamps.lamp_at(Right, place)\n\t\t\teven = RoadLamps.even_along(place)\n\t\t\tleft.across < 0.0\n\t\t\t\tand right.across > 0.0\n\t\t\t\tand (left.along - even).abs() <= RoadLamps.most_nudge\n\t\t\t\tand (right.along - even).abs() <= RoadLamps.most_nudge\n\t\t},\n\t)\n\nexpect [0, 2, 4, 100].all(|place| RoadLamps.lamp_at(Right, place).lantern == Lantern.Amber)\nexpect [1, 3, 99].all(|place| RoadLamps.lamp_at(Left, place).lantern != Lantern.Amber)\nexpect [1, 3, 99].all(|place| RoadLamps.lamp_at(Left, place).lantern == RoadLamps.lamp_at(Right, place).lantern)\n\nexpect {\n\tlamps = RoadLamps.lamps_between({ nearest: 100.0, farthest: 400.0 })\n\tlamps.all(|lamp| lamp.along >= 100.0 and lamp.along <= 400.0)\n\t\tand lamps.len() >= 16\n\t\tand lamps.len() <= 24\n}\n\nexpect RoadLamps.lamps_between({ nearest: -500.0, farthest: -100.0 }) == []\n\nexpect place_at_or_before(-10.0) == 0\nexpect place_at_or_before(36.0) == 1\nexpect place_at_or_before(35.9) == 0\n" },
		{ file: "RoadsideShapes.roc", code: "import Bird\nimport BirdFlight\nimport LampShapes\nimport RoadCamera\nimport RoadLamps\nimport StillOnScreen\nimport lib.Brush\nimport lib.Fraction\nimport lib.Point\nimport lib.Shapes\n\nRoadsideShapes :: [].{\n\n\tDrawn : { forward : F64, shapes : List(Shapes.Shape) }\n\n\tdrawn_lamp : RoadCamera, { lamp : RoadLamps.RoadLamp, day : Fraction } -> Try(RoadsideShapes.Drawn, [BehindCamera])\n\tdrawn_lamp = |camera, { lamp, day }| {\n\t\tfoot = camera.project({ along: lamp.along, across: lamp.across, lift: 0.0 })?\n\t\tforward = camera.forward_of(lamp.along)\n\t\theight_on_screen = RoadCamera.size_on_screen({ height: lamp.lantern.height_metres(), forward })\n\t\tOk({ forward, shapes: LampShapes.lamp_shapes({ foot, height_on_screen }, { lantern: lamp.lantern, day }) })\n\t}\n\n\tdrawn_birds : RoadCamera, { bird : BirdFlight.BirdInstant, flight : BirdFlight } -> List(RoadsideShapes.Drawn)\n\tdrawn_birds = |camera, { bird, flight }|\n\t\tmatch camera.project(bird.location) {\n\t\t\tErr(BehindCamera) => []\n\t\t\tOk(foot) => {\n\t\t\t\tforward = camera.forward_of(bird.location.along)\n\t\t\t\theight_on_screen = RoadCamera.size_on_screen({ height: Bird.height_metres, forward })\n\t\t\t\tanchor = {\n\t\t\t\t\tfoot,\n\t\t\t\t\tflip: Bird.pose_flip(bird.pose, flight.heading()),\n\t\t\t\t\theight_on_screen,\n\t\t\t\t}\n\t\t\t\t{ from, to } = flight.lamps()\n\t\t\t\tnearest = forward.min(camera.forward_of(from.along)).min(camera.forward_of(to.along))\n\t\t\t\t[{ forward: nearest - 0.01, shapes: StillOnScreen.still_shapes(anchor, Bird.pose_still(bird.pose)) }]\n\t\t\t}\n\t\t}\n\n\tlight_pool_shapes : RoadCamera, { lamp : RoadLamps.RoadLamp, day : Fraction } -> List(Shapes.Shape)\n\tlight_pool_shapes = |camera, { lamp, day }| {\n\t\tsides = 20\n\t\tvar \$corners = List.with_capacity(sides)\n\t\tfor k in 0..<sides {\n\t\t\tangle = F64.tau * k.to_f64() / sides.to_f64()\n\t\t\trim_point = camera.project({\n\t\t\t\talong: lamp.along + pool_radius * angle.sin(),\n\t\t\t\tacross: lamp.across + pool_radius * angle.cos(),\n\t\t\t\tlift: 0.0,\n\t\t\t})\n\t\t\t\$corners =\n\t\t\t\tmatch rim_point {\n\t\t\t\t\tOk(corner) => \$corners.append(corner)\n\t\t\t\t\tErr(BehindCamera) => \$corners\n\t\t\t\t}\n\t\t}\n\t\tcorners = \$corners\n\t\tif corners.len() < sides {\n\t\t\t[]\n\t\t} else {\n\t\t\txs = corners.map(|p| p.x.to_f64())\n\t\t\tys = corners.map(|p| p.y.to_f64())\n\t\t\tleast_x = xs.fold(1.0e9, |least, x| least.min(x))\n\t\t\tmost_x = xs.fold(-1.0e9, |most, x| most.max(x))\n\t\t\tleast_y = ys.fold(1.0e9, |least, y| least.min(y))\n\t\t\tmost_y = ys.fold(-1.0e9, |most, y| most.max(y))\n\t\t\tglow = lamp.lantern.glow_color()\n\t\t\tlook = {\n\t\t\t\tstops: {\n\t\t\t\t\tstart_color: Brush.with_alpha(glow, 0.56 - 0.24 * day.to_f64()),\n\t\t\t\t\tend_color: Brush.with_alpha(glow, 0.0),\n\t\t\t\t\tstart_offset: 0.0,\n\t\t\t\t\tend_offset: 1.0,\n\t\t\t\t},\n\t\t\t\tcenter: Point.at((least_x + most_x) / 2.0, (least_y + most_y) / 2.0),\n\t\t\t\taxis_u: Point.at((most_x - least_x) / 2.0, 0.0),\n\t\t\t\taxis_v: Point.at(0.0, (most_y - least_y) / 2.0),\n\t\t\t}\n\t\t\tmatch Brush.elliptical_gradient(look) {\n\t\t\t\tOk(fill) => [Polygon({ corners, fill })]\n\t\t\t\tErr(TooThin) => []\n\t\t\t}\n\t\t}\n\t}\n}\n\npool_radius : F64\npool_radius = 3.2\n" },
		{ file: "SceneCycle.roc", code: "import Bird\nimport BirdFlight\nimport RoadCamera\nimport RoadLamps\nimport lib.Fraction\n\nSceneCycle :: [].{\n\n\tScene : { flight : BirdFlight, steps_into_leg : U64, steps : U64 }\n\n\tleg_steps : U64\n\tleg_steps = perch_steps + BirdFlight.frame_count\n\n\tcycle_steps : U64\n\tcycle_steps = rising_crossings * SceneCycle.leg_steps + closing_perch_steps\n\n\tfirst_scene : SceneCycle.Scene\n\tfirst_scene = { flight: BirdFlight.first, steps_into_leg: 0, steps: 0 }\n\n\tday_at : U64 -> Fraction\n\tday_at = |steps| Fraction.clamp(steps.to_f64() / SceneCycle.cycle_steps.to_f64())\n\n\tscene_at_next_step : SceneCycle.Scene -> SceneCycle.Scene\n\tscene_at_next_step = |scene| {\n\t\tsteps_into_leg = scene.steps_into_leg + 1\n\t\tsteps = scene.steps + 1\n\t\tif steps >= SceneCycle.cycle_steps {\n\t\t\tSceneCycle.first_scene\n\t\t} else if steps_into_leg >= SceneCycle.leg_steps {\n\t\t\t{ flight: scene.flight.next(), steps_into_leg: 0, steps }\n\t\t} else {\n\t\t\t{ ..scene, steps_into_leg, steps }\n\t\t}\n\t}\n\n\tscene_after : SceneCycle.Scene, U64 -> SceneCycle.Scene\n\tscene_after = |scene, count| {\n\t\tvar \$scene = scene\n\t\tfor _k in 0..<count {\n\t\t\t\$scene = SceneCycle.scene_at_next_step(\$scene)\n\t\t}\n\t\t\$scene\n\t}\n\n\tflight_stage : U64 -> BirdFlight.Stage\n\tflight_stage = |steps_into_leg|\n\t\tif steps_into_leg < perch_steps {\n\t\t\tWaiting\n\t\t} else {\n\t\t\tPlaying(steps_into_leg - perch_steps)\n\t\t}\n\n\tcamera_at : U64 -> RoadCamera\n\tcamera_at = |steps| RoadCamera.at({ along: RoadLamps.even_along(0) - follow_distance + camera_speed * steps.to_f64(), across: 0.0 })\n}\n\nperch_steps : U64\nperch_steps = 30\n\nrising_crossings : U64\nrising_crossings = 20\n\nclosing_perch_steps : U64\nclosing_perch_steps = perch_steps\n\ncamera_speed : F64\ncamera_speed = RoadLamps.lamp_spacing / SceneCycle.leg_steps.to_f64()\n\nfollow_distance : F64\nfollow_distance = 34.0\n\nexpect SceneCycle.flight_stage(0) == Waiting and SceneCycle.flight_stage(perch_steps - 1) == Waiting\nexpect SceneCycle.flight_stage(perch_steps) == Playing(0)\nexpect SceneCycle.flight_stage(SceneCycle.leg_steps - 1) == Playing(BirdFlight.frame_count - 1)\nexpect {\n\tlast_of_leg = { flight: BirdFlight.first, steps_into_leg: SceneCycle.leg_steps - 1, steps: 99 }\n\tafter = SceneCycle.scene_at_next_step(last_of_leg)\n\tafter.steps_into_leg == 0 and after.flight == BirdFlight.first.next() and after.steps == 100\n}\n\nexpect {\n\tvar \$scene = SceneCycle.first_scene\n\tvar \$nearest = 1000.0.F64\n\tvar \$farthest = 0.0.F64\n\tvar \$off_screen = 0\n\tfor _step in 0..<SceneCycle.cycle_steps {\n\t\t{ flight, steps_into_leg, steps } = \$scene\n\t\tcamera = SceneCycle.camera_at(steps)\n\t\tbird = flight.bird_instant_at(SceneCycle.flight_stage(steps_into_leg))\n\t\tgap = bird.location.along - camera.along()\n\t\t\$nearest = \$nearest.min(gap)\n\t\t\$farthest = \$farthest.max(gap)\n\t\tcorners = Bird.pose_still(bird.pose).polygons().join_map(|polygon| polygon.points)\n\t\ttop = corners.fold(0.0, |most, corner| most.max(corner.y))\n\t\thalf_width = corners.fold(0.0, |most, corner| most.max(corner.x.abs()))\n\t\theight = RoadCamera.size_on_screen({ height: Bird.height_metres, forward: gap }).to_f64()\n\t\t\$off_screen =\n\t\t\tmatch camera.project(bird.location) {\n\t\t\t\tOk(foot) if foot.x.to_f64() - height * half_width >= 0.0 and foot.x.to_f64() + height * half_width <= RoadCamera.screen_width and foot.y.to_f64() - height * top >= 0.0 and foot.y.to_f64() <= RoadCamera.screen_height => \$off_screen\n\t\t\t\t_ => \$off_screen + 1\n\t\t\t}\n\t\t\$scene = SceneCycle.scene_at_next_step(\$scene)\n\t}\n\t\$nearest >= 12.0 and \$farthest <= 45.0 and \$off_screen == 0 and \$scene == SceneCycle.first_scene\n}\n\nexpect (SceneCycle.camera_at(SceneCycle.leg_steps).along() - SceneCycle.camera_at(0).along() - RoadLamps.lamp_spacing).abs() < 1.0e-9\nexpect (SceneCycle.camera_at(2 * SceneCycle.leg_steps).along() - SceneCycle.camera_at(SceneCycle.leg_steps).along() - RoadLamps.lamp_spacing).abs() < 1.0e-9\nexpect SceneCycle.camera_at(0).along() == RoadLamps.even_along(0) - follow_distance\n\nexpect SceneCycle.cycle_steps == 20 * 66 + 30\nexpect {\n\tlast = { flight: BirdFlight.first, steps_into_leg: 29, steps: SceneCycle.cycle_steps - 1 }\n\tSceneCycle.scene_at_next_step(last) == SceneCycle.first_scene\n}\nexpect {\n\tbefore_last = { flight: BirdFlight.first, steps_into_leg: 28, steps: SceneCycle.cycle_steps - 2 }\n\tafter = SceneCycle.scene_at_next_step(before_last)\n\tafter.steps == SceneCycle.cycle_steps - 1 and after.steps_into_leg == 29\n}\n\nexpect SceneCycle.day_at(0) == Fraction.zero\nexpect SceneCycle.day_at(199) == Fraction.of(199.0 / 1350.0) and SceneCycle.day_at(765) == Fraction.of(765.0 / 1350.0)\nexpect SceneCycle.day_at(SceneCycle.cycle_steps / 2) == Fraction.of(0.5)\nexpect SceneCycle.day_at(SceneCycle.cycle_steps - 2) < SceneCycle.day_at(SceneCycle.cycle_steps - 1) and SceneCycle.day_at(SceneCycle.cycle_steps - 1) != Fraction.whole\n" },
		{ file: "Still.roc", code: "import lib.Fraction\nimport lib.ArgbColor\nimport lib.RgbColor\n\nStill :: List(Still.Polygon).{\n\n\tof : List(Still.Polygon) -> Still\n\tof = |given_polygons| {\n\t\tfor polygon in given_polygons {\n\t\t\tmatch polygon_flaw(polygon) {\n\t\t\t\tSound => {}\n\t\t\t\tFlawed(reason) => crash \"Still.of: \${reason}\"\n\t\t\t}\n\t\t}\n\t\tStill.(given_polygons)\n\t}\n\n\tFramePoint : { x : F64, y : F64 }\n\n\tFrameVector : { x : F64, y : F64 }\n\n\tColorStops : {\n\t\tstart_color : ArgbColor,\n\t\tend_color : ArgbColor,\n\t\tstart_offset : Fraction,\n\t\tend_offset : Fraction,\n\t}\n\n\tGradient : [\n\t\tLinear(\n\t\t\t{\n\t\t\t\tstops : Still.ColorStops,\n\t\t\t\tstart : Still.FramePoint,\n\t\t\t\tend : Still.FramePoint,\n\t\t\t},\n\t\t),\n\t\tRadial(\n\t\t\t{\n\t\t\t\tstops : Still.ColorStops,\n\t\t\t\tcenter : Still.FramePoint,\n\t\t\t\taxis_u : Still.FrameVector,\n\t\t\t\taxis_v : Still.FrameVector,\n\t\t\t},\n\t\t),\n\t]\n\n\tFill : [Flat(RgbColor), Shaded(Still.Gradient)]\n\n\tPolygon : { fill : Still.Fill, points : List(Still.FramePoint) }\n\n\tpolygons : Still -> List(Still.Polygon)\n\tpolygons = |Still.(still_polygons)| still_polygons\n\n\tmin_axes_area : F64\n\tmin_axes_area = 0.000025\n\n\tis_eq : _\n}\n\nFlaw : [Sound, Flawed(Str)]\n\npoint_text : Still.FramePoint -> Str\npoint_text = |point| \"(\${point.x.to_str()}, \${point.y.to_str()})\"\n\npolygon_flaw : Still.Polygon -> Flaw\npolygon_flaw = |polygon|\n\tmatch polygon.points {\n\t\t[] => Flawed(\"a polygon has no corners, and it needs three\")\n\t\t[first, .. as rest] if rest.len() < 2 =>\n\t\t\tFlawed(\"the polygon from \${point_text(first)} has \${(rest.len() + 1).to_str()} corners, and it needs three\")\n\t\t[first, ..] => {\n\t\t\tnext_corners = polygon.points.drop_first(1).concat([first])\n\t\t\tedges = polygon.points.map2(next_corners, |from, to| { from, to })\n\t\t\tmatch edges.find_first(|{ from, to }| from == to) {\n\t\t\t\tOk({ from, .. }) =>\n\t\t\t\t\tFlawed(\"the polygon from \${point_text(first)} repeats its corner \${point_text(from)}\")\n\t\t\t\tErr(NotFound) =>\n\t\t\t\t\tmatch polygon.fill {\n\t\t\t\t\t\tFlat(_) => Sound\n\t\t\t\t\t\tShaded(gradient) => gradient_flaw(gradient)\n\t\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\ngradient_flaw : Still.Gradient -> Flaw\ngradient_flaw = |gradient|\n\tmatch gradient {\n\t\tLinear({ stops, start, end }) =>\n\t\t\tif start == end {\n\t\t\t\tFlawed(\"the linear gradient from \${point_text(start)} ends where it starts\")\n\t\t\t} else {\n\t\t\t\tstops_flaw(stops, \"the linear gradient from \${point_text(start)}\")\n\t\t\t}\n\t\tRadial({ stops, center, axis_u, axis_v }) => {\n\t\t\tarea = (axis_u.x * axis_v.y - axis_u.y * axis_v.x).abs()\n\t\t\tif area < Still.min_axes_area {\n\t\t\t\tleast = Still.min_axes_area.to_str()\n\t\t\t\tFlawed(\"the radial gradient about \${point_text(center)} has axes that span \${area.to_str()}, under \${least}\")\n\t\t\t} else {\n\t\t\t\tstops_flaw(stops, \"the radial gradient about \${point_text(center)}\")\n\t\t\t}\n\t\t}\n\t}\n\nstops_flaw : Still.ColorStops, Str -> Flaw\nstops_flaw = |stops, gradient_name|\n\tif stops.end_offset < stops.start_offset {\n\t\tstart = stops.start_offset.to_f64().to_str()\n\t\tend = stops.end_offset.to_f64().to_str()\n\t\tFlawed(\"\${gradient_name} has its start offset \${start} past its end offset \${end}\")\n\t} else {\n\t\tSound\n\t}\n\nsample_stops : Still.ColorStops\nsample_stops = {\n\tstart_color: ArgbColor.of(0xFF000000),\n\tend_color: ArgbColor.of(0xFFFFFFFF),\n\tstart_offset: Fraction.of(0.25),\n\tend_offset: Fraction.of(0.75),\n}\n\nsample_corners : List(Still.FramePoint)\nsample_corners = [{ x: 0.5, y: 0.0 }, { x: 1.0, y: 0.0 }, { x: 0.5, y: 1.0 }]\n\nlinear_polygon : Still.ColorStops, Still.FramePoint -> Still.Polygon\nlinear_polygon = |stops, end| {\n\tgradient = Linear({\n\t\tstops,\n\t\tstart: { x: 0.5, y: 0.0 },\n\t\tend,\n\t})\n\t{ fill: Shaded(gradient), points: sample_corners }\n}\n\nradial_polygon : Still.FrameVector, Still.FrameVector -> Still.Polygon\nradial_polygon = |axis_u, axis_v| {\n\tgradient = Radial({\n\t\tstops: sample_stops,\n\t\tcenter: { x: 0.5, y: 0.25 },\n\t\taxis_u,\n\t\taxis_v,\n\t})\n\t{ fill: Shaded(gradient), points: sample_corners }\n}\n\nradial_of_area : F64 -> Still.Polygon\nradial_of_area = |area| radial_polygon({ x: area, y: 0.0 }, { x: 0.0, y: 1.0 })\n\nflat_polygon : List(Still.FramePoint) -> Still.Polygon\nflat_polygon = |corners| { fill: Flat(RgbColor.of(7)), points: corners }\n\nexpect polygon_flaw(flat_polygon(sample_corners)) == Sound\nexpect\n\tpolygon_flaw(flat_polygon(sample_corners.take_first(2)))\n\t\t== Flawed(\"the polygon from (0.5, 0) has 2 corners, and it needs three\")\nexpect polygon_flaw(flat_polygon([])) == Flawed(\"a polygon has no corners, and it needs three\")\n\nexpect {\n\tdoubled = [{ x: 0.5, y: 0.0 }, { x: 1.0, y: 0.0 }, { x: 1.0, y: 0.0 }, { x: 0.5, y: 1.0 }]\n\tpolygon_flaw(flat_polygon(doubled)) == Flawed(\"the polygon from (0.5, 0) repeats its corner (1, 0)\")\n}\nexpect\n\tpolygon_flaw(flat_polygon(sample_corners.concat([{ x: 0.5, y: 0.0 }])))\n\t\t== Flawed(\"the polygon from (0.5, 0) repeats its corner (0.5, 0)\")\n\nexpect stops_flaw({ ..sample_stops, end_offset: Fraction.of(0.25) }, \"g\") == Sound\nexpect {\n\tcrossed_stops = {\n\t\t..sample_stops,\n\t\tstart_offset: Fraction.of(0.75),\n\t\tend_offset: Fraction.of(0.25),\n\t}\n\tstops_flaw(crossed_stops, \"g\") == Flawed(\"g has its start offset 0.75 past its end offset 0.25\")\n}\n\nexpect polygon_flaw(linear_polygon(sample_stops, { x: 0.5, y: 1.0 })) == Sound\nexpect\n\tpolygon_flaw(linear_polygon(sample_stops, { x: 0.5, y: 0.0 }))\n\t\t== Flawed(\"the linear gradient from (0.5, 0) ends where it starts\")\n\nexpect {\n\tcrossed_stops = { ..sample_stops, start_offset: Fraction.whole }\n\tpolygon_flaw(linear_polygon(crossed_stops, { x: 0.5, y: 1.0 }))\n\t\t== Flawed(\"the linear gradient from (0.5, 0) has its start offset 1 past its end offset 0.75\")\n}\n\nexpect polygon_flaw(radial_of_area(Still.min_axes_area)) == Sound\nexpect polygon_flaw(radial_of_area(0.00002)) != Sound\nexpect\n\tpolygon_flaw(radial_polygon({ x: 0.5, y: 0.5 }, { x: 0.25, y: 0.25 }))\n\t\t== Flawed(\"the radial gradient about (0.5, 0.25) has axes that span 0, under 2.5e-5\")\n" },
		{ file: "StillOnScreen.roc", code: "import Still\nimport lib.Brush\nimport lib.Pixels\nimport lib.Point\nimport lib.Shapes\n\nStillOnScreen :: [].{\n\n\tFlip : [AsDrawn, Mirrored]\n\n\tAnchor : {\n\t\tfoot : Point,\n\t\tflip : StillOnScreen.Flip,\n\t\theight_on_screen : Pixels,\n\t}\n\n\tscreen_point : StillOnScreen.Anchor, Still.FramePoint -> Point\n\tscreen_point = |anchor, point| {\n\t\tstep = screen_vector(anchor, point)\n\t\t{ x: anchor.foot.x.plus(step.x), y: anchor.foot.y.plus(step.y) }\n\t}\n\n\tstill_shapes : StillOnScreen.Anchor, Still -> List(Shapes.Shape)\n\tstill_shapes = |anchor, still|\n\t\tstill.polygons().map(|polygon| still_polygon(anchor, polygon))\n}\n\nx_sign : StillOnScreen.Flip -> F64\nx_sign = |flip|\n\tmatch flip {\n\t\tAsDrawn => 1.0\n\t\tMirrored => -1.0\n\t}\n\nscreen_vector : StillOnScreen.Anchor, Still.FrameVector -> Point\nscreen_vector = |anchor, step| {\n\tx: anchor.height_on_screen.times(x_sign(anchor.flip) * step.x),\n\ty: anchor.height_on_screen.times(step.y).opposite(),\n}\n\nstill_polygon : StillOnScreen.Anchor, Still.Polygon -> Shapes.Shape\nstill_polygon = |anchor, polygon| {\n\tpoints = polygon.points.map(|point| StillOnScreen.screen_point(anchor, point))\n\tmatch polygon.fill {\n\t\tFlat(color) => Shapes.region_from_corners(points, Brush.flat(color))\n\t\tShaded(gradient) => still_gradient_polygon(anchor, { gradient, points })\n\t}\n}\n\nstill_gradient_polygon : StillOnScreen.Anchor,\n{\n\tgradient : Still.Gradient,\n\tpoints : List(Point),\n} -> Shapes.Shape\nstill_gradient_polygon = |anchor, { gradient, points }|\n\tmatch gradient {\n\t\tLinear({ stops, start, end }) => {\n\t\t\tfill = Brush.linear_gradient({\n\t\t\t\tstops: brush_stops(stops),\n\t\t\t\tstart_point: StillOnScreen.screen_point(anchor, start),\n\t\t\t\tend_point: StillOnScreen.screen_point(anchor, end),\n\t\t\t})\n\t\t\tShapes.region_from_corners(points, fill)\n\t\t}\n\t\tRadial({ stops, center, axis_u, axis_v }) => {\n\t\t\tellipse = Brush.elliptical_gradient({\n\t\t\t\tstops: brush_stops(stops),\n\t\t\t\tcenter: StillOnScreen.screen_point(anchor, center),\n\t\t\t\taxis_u: screen_vector(anchor, axis_u),\n\t\t\t\taxis_v: screen_vector(anchor, axis_v),\n\t\t\t})\n\t\t\tfill =\n\t\t\t\tmatch ellipse {\n\t\t\t\t\tOk(gradient_fill) => gradient_fill\n\t\t\t\t\tErr(TooThin) => crash \"StillOnScreen.still_gradient_polygon: an ellipse too thin for Brush to invert\"\n\t\t\t\t}\n\t\t\tShapes.region_from_corners(points, fill)\n\t\t}\n\t}\n\nbrush_stops : Still.ColorStops -> Brush.TwoStops\nbrush_stops = |stops| {\n\tstart_color: Brush.translucent(stops.start_color),\n\tend_color: Brush.translucent(stops.end_color),\n\tstart_offset: stops.start_offset.to_f64(),\n\tend_offset: stops.end_offset.to_f64(),\n}\n\nsample_foot : Point\nsample_foot = Point.at(100.0, 200.0)\n\nupright : StillOnScreen.Anchor\nupright = {\n\tfoot: sample_foot,\n\tflip: AsDrawn,\n\theight_on_screen: Pixels.of(50.0),\n}\n\nmirrored : StillOnScreen.Anchor\nmirrored = {\n\tfoot: sample_foot,\n\tflip: Mirrored,\n\theight_on_screen: Pixels.of(50.0),\n}\n\nexpect StillOnScreen.screen_point(upright, { x: 0.5, y: 0.4 }) == Point.at(125.0, 180.0)\nexpect StillOnScreen.screen_point(mirrored, { x: 0.5, y: 0.4 }) == Point.at(75.0, 180.0)\nexpect StillOnScreen.screen_point(upright, { x: 0.0, y: 0.0 }) == Point.at(100.0, 200.0)\n" },
		{ file: "Sunrise.roc", code: "import Easing\nimport lib.Fraction\nimport lib.Pixels\nimport lib.Point\nimport lib.RgbColor\nimport lib.ColorShade\n\nSunrise :: [].{\n\n\tLight : {\n\t\tsky_top : RgbColor,\n\t\tsky_horizon : RgbColor,\n\t\tfar_range : RgbColor,\n\t\thills : RgbColor,\n\t\tgrass_far : RgbColor,\n\t\tgrass_near : RgbColor,\n\t\troad : RgbColor,\n\t\tsun_center : Point,\n\t\tsun_inner : RgbColor,\n\t\tsun_outer : RgbColor,\n\t\tsun_glow : RgbColor,\n\t\tsun_glow_alpha : F64,\n\t}\n\n\tlight_at : Fraction -> Sunrise.Light\n\tlight_at = |day| {\n\t\tbetween = |{ dawn, morning }| ColorShade.color_between({ from: RgbColor.of(dawn), to: RgbColor.of(morning), fraction: day })\n\t\t{\n\t\t\tsky_top: between({ dawn: 0x2E4580, morning: 0x6FA0E0 }),\n\t\t\tsky_horizon: between({ dawn: 0xF49A5C, morning: 0xFFE6BC }),\n\t\t\tfar_range: between({ dawn: 0x5F5880, morning: 0x9C98BC }),\n\t\t\thills: between({ dawn: 0x4C5E3C, morning: 0x7E9C66 }),\n\t\t\tgrass_far: between({ dawn: 0x5E8048, morning: 0x8DB866 }),\n\t\t\tgrass_near: between({ dawn: 0x40663A, morning: 0x669A4A }),\n\t\t\troad: between({ dawn: 0x524E5A, morning: 0x807C88 }),\n\t\t\tsun_center: sun_center_at(day),\n\t\t\tsun_inner: between({ dawn: 0xFFD08A, morning: 0xFFF8E0 }),\n\t\t\tsun_outer: between({ dawn: 0xFF7E48, morning: 0xFFD090 }),\n\t\t\tsun_glow: between({ dawn: 0xFFA868, morning: 0xFFE8B0 }),\n\t\t\tsun_glow_alpha: Easing.lerp({ from: 0.5, to: 0.45, fraction: day }),\n\t\t}\n\t}\n\n\tfar_range_corners : List(Point)\n\tfar_range_corners = far_ridge_points.concat([Point.at(960.0, horizon_below), Point.at(0.0, horizon_below)])\n\n\tsun_radius : Pixels\n\tsun_radius = Pixels.of(sun_radius_f64)\n}\n\nfar_ridge_points : List(Point)\nfar_ridge_points = [\n\tPoint.at(0.0, 250.0),\n\tPoint.at(120.0, 200.0),\n\tPoint.at(250.0, 238.0),\n\tPoint.at(400.0, 150.0),\n\tPoint.at(560.0, 232.0),\n\tPoint.at(690.0, 188.0),\n\tPoint.at(820.0, 258.0),\n\tPoint.at(960.0, 205.0),\n]\n\nhorizon_below : F64\nhorizon_below = 381.0\n\nsun_radius_f64 : F64\nsun_radius_f64 = 38.0\n\nsun_start : { x : F64, y : F64 }\nsun_start = { x: 553.0, y: 301.0 }\n\nsun_end : { x : F64, y : F64 }\nsun_end = { x: 480.0, y: 60.0 }\n\nsun_center_at : Fraction -> Point\nsun_center_at = |day|\n\tPoint.at(\n\t\tEasing.lerp({ from: sun_start.x, to: sun_end.x, fraction: day }),\n\t\tEasing.lerp({ from: sun_start.y, to: sun_end.y, fraction: day }),\n\t)\n\nridge_y_at : F64 -> F64\nridge_y_at = |x| {\n\tvar \$y = horizon_below\n\tfor k in 0..<(far_ridge_points.len() - 1) {\n\t\tleft = far_ridge_points.get(k) ?? crash \"Sunrise.ridge_y_at: a ridge point inside the list\"\n\t\tright = far_ridge_points.get(k + 1) ?? crash \"Sunrise.ridge_y_at: a ridge point inside the list\"\n\t\tx0 = left.x.to_f64()\n\t\tx1 = right.x.to_f64()\n\t\tif x >= x0 and x <= x1 {\n\t\t\t\$y = left.y.to_f64() + (right.y.to_f64() - left.y.to_f64()) * (x - x0) / (x1 - x0)\n\t\t} else {\n\t\t\t{}\n\t\t}\n\t}\n\t\$y\n}\n\nSunAgainstRidge : [Clear, Touching, Hidden]\n\nsun_against_ridge : Point -> SunAgainstRidge\nsun_against_ridge = |center| {\n\tcx = center.x.to_f64()\n\tcy = center.y.to_f64()\n\tvar \$above = 0\n\tvar \$behind = 0\n\tfor k in 0..=32 {\n\t\tdx = sun_radius_f64 * (k.to_f64() / 16.0 - 1.0)\n\t\thalf_height = (sun_radius_f64 * sun_radius_f64 - dx * dx).max(0.0).sqrt()\n\t\tridge = ridge_y_at(cx + dx)\n\t\tif cy + half_height < ridge {\n\t\t\t\$above = \$above + 1\n\t\t} else {\n\t\t\t{}\n\t\t}\n\t\tif cy - half_height >= ridge {\n\t\t\t\$behind = \$behind + 1\n\t\t} else {\n\t\t\t{}\n\t\t}\n\t}\n\tif \$above == 33 {\n\t\tClear\n\t} else if \$behind == 33 {\n\t\tHidden\n\t} else {\n\t\tTouching\n\t}\n}\n\nexpect sun_against_ridge(sun_center_at(Fraction.zero)) == Hidden\nexpect sun_against_ridge(sun_center_at(Fraction.of(198.0 / 1350.0))) == Hidden\nexpect sun_against_ridge(sun_center_at(Fraction.of(199.0 / 1350.0))) == Touching\nexpect sun_against_ridge(sun_center_at(Fraction.of(764.0 / 1350.0))) == Touching\nexpect sun_against_ridge(sun_center_at(Fraction.of(765.0 / 1350.0))) == Clear\nexpect sun_against_ridge(sun_center_at(Fraction.whole)) == Clear\n\nexpect ridge_y_at(560.0) == 232.0 and ridge_y_at(480.0) == 191.0\n\nexpect Sunrise.light_at(Fraction.zero).sky_top == RgbColor.of(0x2E4580)\nexpect Sunrise.light_at(Fraction.whole).sky_top == RgbColor.of(0x6FA0E0)\nexpect {\n\tdawn = Sunrise.light_at(Fraction.zero).sky_top\n\tmiddle = Sunrise.light_at(Fraction.of(0.5)).sky_top\n\tmorning = Sunrise.light_at(Fraction.whole).sky_top\n\tdawn.blue() < middle.blue() and middle.blue() < morning.blue()\n}\n" },
		{ file: "main.roc", code: "app [Model, program] {\n\tlib: \"../../lib/main.roc\",\n\tnative: \"../../native/main.roc\",\n\tpf: platform \"../../platform/main.roc\",\n}\n\nimport native.NativeApp\nimport LanternsApp\n\nModel : LanternsApp.Model\n\nprogram = NativeApp.program(LanternsApp.canvas_app)\n" },
		{ file: "web.roc", code: "app [Model, program] {\n\tlib: \"../../lib/main.roc\",\n\tpf: platform \"../../web/lanterns_platform/main.roc\",\n\tsc: \"../../../roc-syntax-color/package/main.roc\",\n}\n\nimport lib.Skin\nimport CodePane\n\nModel : CodePane.Model\n\nskin : Skin.Skin\nskin = {\n\tshow_loading_indicator: Bool.True,\n\tshow_keyboard_help: Bool.True,\n\tlinks: [\n\t\t{ label: \"Home\", url: \"https://roc.lynrummy.com\" },\n\t\t{ label: \"Code\", url: \"https://github.com/showell/roc-screensaver\" },\n\t],\n}\n\nprogram = CodePane.program(skin)\n" },
	]
}
