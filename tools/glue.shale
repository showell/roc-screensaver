-- Regenerates roc glue's snapshot of the seam, host/glue/platform_abi.zig,
-- which host/abi_test.zig holds host/abi.zig to. Run it from the repo's
-- root after any change to platform/:
--   shale tools/glue.shale
-- It runs `roc glue` with the pinned compiler (roc-version) and Roc's Zig
-- glue spec, which the compiler does not ship, into .zig-cache/roc-glue,
-- then `zig fmt`, then writes the snapshot, saying whether it changed.
--
-- The spec is read from a Roc source checkout at the pin's commit,
-- ~/tools/roc-<commit>. Without one it uses ~/tools/roc-0602c5f and says
-- so: on 2026-11-15 every .roc file under src/glue/ at 34bd006 (this pin)
-- was byte for byte the same as at 0602c5f. A pin move has to check that
-- again, or install the checkout.

const out_dir = ".zig-cache/roc-glue"
const snapshot = "host/glue/platform_abi.zig"

if not exists("platform/main.roc") then
  fail("glue: run it from roc-screensaver's root (no platform/main.roc here)")
end

const pin = trim(read("roc-version"))
const roc = real("tools:roc-" .. pin .. "/roc")
local parts = split(pin, "-")
local commit = parts[#parts]
local spec = "tools:roc-" .. commit .. "/src/glue/src/ZigGlue.roc"
if not exists(spec) then
  if commit ~= "34bd006" then
    fail("glue: no glue spec at " .. spec .. ": check out roc-lang/roc at " .. commit .. " as ~/tools/roc-" .. commit)
  end
  spec = "tools:roc-0602c5f/src/glue/src/ZigGlue.roc"
  print("glue: no checkout at the pin's commit; using " .. spec .. ", whose glue spec is the pin's")
end

if exists(out_dir) then remove_tree(out_dir) end
mkdir(out_dir)
must(run({roc, "glue", real(spec), out_dir, "platform/main.roc"}, {timeout_ms = 60000, tail = 20}))
const made = out_dir .. "/roc_platform_abi.zig"
must(run({"zig", "fmt", made}, {timeout_ms = 30000, tail = 20}))

local after = read(made)
if exists(snapshot) and read(snapshot) == after then
  print("glue: " .. snapshot .. " unchanged (roc " .. pin .. ")")
else
  if not exists("host/glue") then mkdir("host/glue") end
  replace(snapshot, after)
  print("glue: " .. snapshot .. " written (roc " .. pin .. "): `zig build test` holds host/abi.zig to it")
end
