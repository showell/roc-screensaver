-- web_build.shale builds each screensaver's page in screensavers/list.txt into
-- the dev channel, ~/build/roc-apps/next/<name>/, which roc-apps' dev server
-- serves at http://localhost:9210/<name>/.
--
--   shale tools/web_build.shale            # every screensaver's page, the release wasm, what is served
--   shale tools/web_build.shale saver=bubbles          # that screensaver's alone
--   shale tools/web_build.shale opt=dev    # the dev backend, for quick iteration
--   shale tools/web_build.shale saver=lanterns dest=lanterns-skins   # into another folder of the dev channel, for a branch
--
-- It builds the wasm host (web/platform/host.zig, against the roc checkout's
-- builtins, with Zig 0.16 as roc-apps does), then the app's wasm with the
-- pinned Roc, then roc_glue.js from the platform's type table with the same
-- compiler. The platform is the one the screensaver's web.roc names: the
-- canvas apps' (web/platform/), or Lanterns' (web/lanterns_platform/, which
-- adds the code pane), and the page gets that platform's own scripts beside
-- the runner's. The wasm is `--opt=speed` unless `opt=dev` says otherwise: it takes
-- some seconds longer to build and is about a third the size, and its frames
-- are the ones the page is meant to be seen with. BUILT says which was built.
-- A screensaver whose list.txt line names a shot step also gets shot.png, the
-- landing page's picture of it: the native PNG harness's frame at that step
-- (`zig build png`, which the gate holds to the page's frame at the same
-- step), squeezed by roc-apps' site/squeeze_png.mjs, and BUILT names the step.
-- This is the one place a shot is made: roc-apps' site/publish_screensavers.shale
-- copies the dev channel's folder, shot and all, to staging.
-- Everything goes to a staging folder that takes the page's place only when every step passed, so a failed build leaves the
-- served page as it was.

-- The pinned compiler, from this repo's roc-version, refused unless it says
-- it is that pin.
function pinned_roc()
  local pin = trim(read("roc-version"))
  local roc = real("tools:roc-" .. pin .. "/roc")
  local v = must(run({roc, "version"}, {timeout_ms = 10000, tail = 2}))
  if trim(v.out) ~= "Roc compiler version " .. pin then fail("web_build: " .. roc .. " says " .. trim(v.out) .. ", not " .. pin) end
  return roc
end

const SQUEEZE = "repos:roc-apps/site/squeeze_png.mjs"
const SQUEEZE_WANT = "script: roc-apps' site/squeeze_png.mjs recompresses the native harness's frame"

-- Roc exits non-zero for a warning, so a build's verdict is its marks.
function marks_of(out)
  return #find_all(out, "✗") + #find_all(out, "●")
end

-- shot.png in `staging`: the native harness's frame after `step` steps of
-- the screensaver `name`, squeezed.
function make_shot(name, step, staging)
  if not exists(SQUEEZE) then fail("web_build: no " .. SQUEEZE .. ", which makes " .. name .. "'s shot.png small") end
  local frames = fresh_dir("build:roc-screensaver", name .. "-shot")
  local b = run({"zig", "build", "-Dapp=screensavers/" .. name .. "/main.roc", "png", "--", real(frames), "" .. step},
    {timeout_ms = 300000, tail = 20})
  if b.code ~= 0 then
    print(b.out)
    fail("web_build: the native harness failed on " .. name)
  end
  local padded = "" .. step
  while #padded < 3 do padded = "0" .. padded end
  local squeezed = must(run({"node", real(SQUEEZE), real(frames .. "/step-" .. padded .. ".png"), real(staging) .. "/shot.png"},
    {timeout_ms = 60000, tail = 5, want = SQUEEZE_WANT}))
  remove_tree(frames)
  print(name .. " shot (step " .. step .. "): " .. (b.ms + squeezed.ms) .. " ms, " .. stat(staging .. "/shot.png").size .. " bytes")
  return nil
end

-- One screensaver's page, its wasm and glue built into a staging folder that
-- takes the place of the dev channel's `folder` only when every step passed.
function page_build(roc, page)
  local name = page.name
  local opt = page.opt
  local dest = "build:roc-apps/next/" .. page.folder
  local staging = dest .. ".staging"
  if exists(staging) then remove_tree(staging) end
  mkdir(staging)

  local wasm_path = staging .. "/" .. name .. ".wasm"
  local wasm = run({roc, "build", "web.roc", "--target=wasm32", "--opt=" .. opt, "--output=" .. real(wasm_path)},
    {cwd = "screensavers/" .. name, timeout_ms = 300000, tail = 60})
  if marks_of(wasm.out) > 0 or not exists(wasm_path) then
    print(wasm.out)
    fail("web_build: " .. name .. "'s wasm build failed")
  end
  print(name .. " wasm (opt " .. opt .. "): " .. wasm.ms .. " ms, " .. stat(wasm_path).size .. " bytes")

  local platform = web_platform_of(name)
  local glue = must(run({roc, "glue", "web/glue/JsGlue.roc", real(staging), platform.main},
    {timeout_ms = 120000, tail = 30}))
  if not exists(staging .. "/roc_glue.js") then print(glue.out) fail("web_build: glue wrote no roc_glue.js") end
  print(name .. " glue: " .. glue.ms .. " ms")

  copy("web/shapes_canvas.js", staging .. "/shapes_canvas.js")
  copy("web/canvas_app_runner.js", staging .. "/canvas_app_runner.js")
  for script in glob(platform.dir .. "/*.js") do copy(script, staging .. "/" .. basename(script)) end
  copy("screensavers/" .. name .. "/page.html", staging .. "/index.html")
  local built = trim(must(run({roc, "version"}, {timeout_ms = 10000, tail = 2})).out) .. "\nopt " .. opt .. "\n"
  if has_key(page, "shot_step") then
    make_shot(name, page.shot_step, staging)
    built = built .. "shot.png: the native harness's frame after " .. page.shot_step .. " steps\n"
  end
  create(staging .. "/BUILT", built)

  if exists(dest) then remove_tree(dest) end
  copy(staging, dest)
  remove_tree(staging)
  for p in glob(dest .. "/*") do print(p) end
  print("dev: http://localhost:9210/" .. page.folder .. "/")
end

local opt = arg("opt", "speed")
if opt ~= "speed" and opt ~= "dev" then fail("web_build: opt=" .. opt .. " is neither speed (the default) nor dev") end
local listed = screensavers_listed()
local chosen = {}
local saver = arg("saver", "")
for s in listed do
  if saver == "" or saver == s.name then push(chosen, s) end
end
if #chosen == 0 then fail("web_build: saver=" .. saver .. " is not in screensavers/list.txt") end
-- The dev channel's folder, a plain name, so a branch's build never replaces
-- the page master's build serves. It names one page, so it needs one saver.
local dest = arg("dest", "")
if dest ~= "" then
  if saver == "" then fail("web_build: dest=" .. dest .. " names one folder; say which saver= goes in it") end
  if re_find(dest, "^[a-z0-9-]+$") == nil then fail("web_build: dest=" .. dest .. " is not a plain folder name") end
end

local roc = pinned_roc()
-- The wasm host is the same for every page, so it is built once.
local host = must(run({real("zig016:zig"), "build", "-Droc=" .. real("repos:roc"),
  "--cache-dir", real("build:roc-screensaver/zig-cache"), "--global-cache-dir", real("build:zig-global")},
  {cwd = "web", timeout_ms = 300000, tail = 30}))
print("host: " .. host.ms .. " ms")
for s in chosen do
  local page = {name = s.name, folder = s.name, opt = opt}
  if dest ~= "" then page.folder = dest end
  if has_key(s, "shot_step") then page.shot_step = s.shot_step end
  page_build(roc, page)
end
